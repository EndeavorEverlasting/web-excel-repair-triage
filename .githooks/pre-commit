#!/bin/sh
set -eu

# Path-only staged gate: does not read or print artifact contents.
python scripts/validate_staged_artifacts.py

staged_tree="$(mktemp -d "${TMPDIR:-/tmp}/web-excel-harness-index.XXXXXX")"
HARNESS_REPORT="${TMPDIR:-/tmp}/web-excel-harness-pre-commit.json"
trap 'rm -rf "$staged_tree"' EXIT HUP INT TERM

git checkout-index --all --prefix="$staged_tree/"
(
  cd "$staged_tree"
  python scripts/validate_harness.py --report "$HARNESS_REPORT"
  python -m unittest tests.test_harness_contract tests.test_powershell_command_envelope -v
  python -m unittest tests.test_local_hook_artifact_hygiene -v
)
git diff --cached --check
