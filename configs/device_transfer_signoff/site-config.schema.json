{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "device-transfer-signoff-site-config/v1",
  "title": "Device Transfer / Stock Sign-Off site config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_family",
    "site",
    "source",
    "shipment"
  ],
  "properties": {
    "artifact_family": {
      "const": "device_transfer_signoff"
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "code",
        "address",
        "poc",
        "delivery_date",
        "delivery_time",
        "origin",
        "prepared_by",
        "signoff_id"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "code": {"type": "string", "minLength": 1},
        "address": {"type": "string", "minLength": 1},
        "poc": {"type": "string", "minLength": 1},
        "delivery_date": {"type": "string", "format": "date"},
        "delivery_time": {"type": "string", "minLength": 1},
        "origin": {"type": "string", "minLength": 1},
        "prepared_by": {"type": "string", "minLength": 1},
        "signoff_id": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_type_header"],
      "properties": {
        "sheet": {"type": ["string", "null"]},
        "device_type_header": {"type": "string", "minLength": 1}
      }
    },
    "shipment": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "qty"],
        "properties": {
          "item": {"type": "string", "minLength": 1},
          "qty": {"type": "integer", "minimum": 1},
          "note": {"type": "string"},
          "serial_source": {"type": "string"},
          "serial_header": {"type": "string"}
        }
      }
    }
  }
}
