{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EndeavorEverlasting/FUN/schemas/nth-identity-abstraction-policy.schema.json",
  "title": "FUN NTH identity abstraction policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_id",
    "artifact_type",
    "identity_tokens",
    "allowed_named_ranges",
    "forbidden_special_case_labels"
  ],
  "properties": {
    "schema": {
      "const": "fun-nth-identity-abstraction-policy/v1"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_type": {
      "enum": ["share_ready", "internal", "fixture"]
    },
    "identity_tokens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["token"],
        "properties": {
          "token": {
            "type": "string",
            "minLength": 2
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2
            },
            "uniqueItems": true
          }
        }
      }
    },
    "allowed_named_ranges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sheet", "range", "purpose"],
        "properties": {
          "sheet": {
            "type": "string",
            "minLength": 1
          },
          "range": {
            "type": "string",
            "pattern": "^[A-Z]+[1-9][0-9]*:[A-Z]+[1-9][0-9]*$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "forbidden_special_case_labels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      },
      "uniqueItems": true
    },
    "allowed_identity_exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sheet", "cell", "reason"],
        "properties": {
          "sheet": {
            "type": "string",
            "minLength": 1
          },
          "cell": {
            "type": "string",
            "pattern": "^[A-Z]+[1-9][0-9]*$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "proof_ceiling": {
      "type": "string",
      "minLength": 1
    }
  }
}
