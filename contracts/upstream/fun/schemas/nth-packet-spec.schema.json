{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EndeavorEverlasting/FUN/schemas/nth-packet-spec.schema.json",
  "title": "NTH Packet Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packet_id",
    "period",
    "controls",
    "workstreams",
    "palette",
    "share_surface",
    "proof_boundaries"
  ],
  "properties": {
    "schema": {"const": "fun-nth-packet-spec/v1"},
    "packet_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "start", "end"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "start": {"type": "string", "format": "date"},
        "end": {"type": "string", "format": "date"}
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hours", "shift_records", "control_kind"],
      "properties": {
        "hours": {"type": "number", "minimum": 0},
        "shift_records": {"type": "integer", "minimum": 0},
        "control_kind": {"enum": ["paid", "submitted", "operational"]},
        "configuration_hours": {"type": "number", "minimum": 0},
        "support_hours": {"type": "number", "minimum": 0},
        "configuration_completion": {"type": "string", "format": "date"}
      }
    },
    "workstreams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "hours", "color", "allocation_basis", "included_activities", "evidence_authority", "defense_boundaries", "share_safe_claim"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
          "label": {"type": "string", "minLength": 1},
          "hours": {"type": "number", "minimum": 0},
          "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
          "allocation_basis": {"type": "array", "minItems": 1, "items": {"type": "object"}},
          "included_activities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "evidence_authority": {"type": "array", "minItems": 1, "items": {"type": "object"}},
          "defense_boundaries": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "share_safe_claim": {"type": "string", "minLength": 1}
        }
      }
    },
    "palette": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
    },
    "share_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_name", "approved_tabs", "forbidden_content"],
      "properties": {
        "artifact_name": {"type": "string", "minLength": 1},
        "approved_tabs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "forbidden_content": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "proof_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
