{
  "schema_version": "prompt-kit-browser-proof-cleanup-harness/v1",
  "capability_id": "prompt-kit-browser-proof-scratch-cleanup",
  "repository": "EndeavorEverlasting/web-excel-repair-triage",
  "governance": "AGENTS.md",
  "purpose": "Classify, report, and safely remove detached Prompt Kit browser-proof scratch directories without touching canonical checkouts, browser profile data, Favorites, or durable repository evidence.",
  "scratch_contract": {
    "system_temp_only": true,
    "directory_name_regex": "^prompt-kit-browser-proof-[0-9a-fA-F]{16,64}$",
    "required_marker": "web/prompt-kit/index.html",
    "reject_reparse_points": true,
    "preview_is_default": true,
    "apply_requires_explicit_switch": true,
    "default_minimum_age_minutes": 60,
    "browser_profile_data_out_of_scope": true,
    "favorites_local_storage_out_of_scope": true
  },
  "components": {
    "codebase_map": "harness/browser-proof-cleanup/CODEBASE_MAP.md",
    "workflow": "harness/browser-proof-cleanup/WORKFLOW.md",
    "artifact_registry_human": "harness/browser-proof-cleanup/ARTIFACT_REGISTRY.md",
    "artifact_registry_machine": "harness/browser-proof-cleanup/artifacts.v1.json",
    "validator_registry": "harness/browser-proof-cleanup/validators.v1.json",
    "trigger_registry": "harness/browser-proof-cleanup/triggers.v1.json",
    "cleanup_runner": "scripts/Clear-PromptKitBrowserProofScratch.ps1",
    "completeness_validator": "scripts/validate_prompt_kit_browser_proof_cleanup.py",
    "contract_tests": "tests/test_prompt_kit_browser_proof_cleanup_harness.py",
    "pre_commit_hook": "harness/browser-proof-cleanup/hooks/pre-commit.sh",
    "pre_push_hook": "harness/browser-proof-cleanup/hooks/pre-push.sh",
    "skill": ".ai/skills/prompt-kit-browser-proof-cleanup/SKILL.md",
    "operator_report": "harness/browser-proof-cleanup/reports/CURRENT_STATE.md",
    "ci": ".github/workflows/prompt-kit-browser-proof-cleanup.yml"
  },
  "validation_order": [
    "python -m py_compile scripts/validate_prompt_kit_browser_proof_cleanup.py tests/test_prompt_kit_browser_proof_cleanup_harness.py",
    "python scripts/validate_prompt_kit_browser_proof_cleanup.py --summary",
    "python -m unittest tests.test_prompt_kit_browser_proof_cleanup_harness -v",
    "pwsh -NoLogo -NoProfile -File scripts/Clear-PromptKitBrowserProofScratch.ps1",
    "git diff --check"
  ],
  "proof_ceiling": "Repository contract, static test, CI, and test-owned temporary-directory cleanup proof. Native Windows/P-Top cleanup of an operator-owned browser-proof directory remains an operator runtime gate."
}
