{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prompt-build-receipt/v1",
  "title": "Prompt Build Receipt",
  "description": "Deterministic provenance receipt for one Language Engine render.",
  "schema_version": "prompt-build-receipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prompt_id",
    "semantic_sha256",
    "context_sha256",
    "execution_profile",
    "language_engine_revision",
    "effective_prompt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "prompt-build-receipt/v1"},
    "prompt_id": {"type": "string", "pattern": "^P[0-9]{2,4}$"},
    "semantic_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "context_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "profile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "execution_profile": {"type": "string", "enum": ["exhaustive", "efficient"]},
    "language_engine_revision": {"type": "string", "minLength": 1, "maxLength": 80},
    "effective_prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "activated_obligations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 80}
    },
    "non_weakening_passed": {"type": "boolean"}
  }
}
