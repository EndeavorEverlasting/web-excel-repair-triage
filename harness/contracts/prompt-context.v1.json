{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prompt-context/v1",
  "title": "Prompt Context IR",
  "description": "Bounded deterministic compilation context produced by the Context Engine from owner-native artifacts. Not a conversation dump, memory store, or event log.",
  "schema_version": "prompt-context/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "execution", "history", "evidence"],
  "properties": {
    "schema_version": {"const": "prompt-context/v1"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "active_contracts", "owned_scope"],
      "properties": {
        "head": {"type": "string", "minLength": 7, "maxLength": 64, "pattern": "^[0-9a-fA-F]+$"},
        "active_contracts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        },
        "owned_scope": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available_capabilities", "parallel_width", "safe_capacity"],
      "properties": {
        "available_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 80}
        },
        "parallel_width": {"type": "integer", "minimum": 0, "maximum": 64},
        "safe_capacity": {"type": "integer", "minimum": 0, "maximum": 64},
        "dependency_ready_width": {"type": "integer", "minimum": 0, "maximum": 64}
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relevant_recurrences"],
      "properties": {
        "relevant_recurrences": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["open_recovery", "known_acceptance_gates"],
      "properties": {
        "open_recovery": {"type": "boolean"},
        "known_acceptance_gates": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        },
        "effective_prompt_identity": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 160}
          ]
        }
      }
    },
    "source_adapters": {
      "type": "array",
      "description": "Read-only adapter names that contributed context; never event ownership.",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 80}
    }
  }
}
