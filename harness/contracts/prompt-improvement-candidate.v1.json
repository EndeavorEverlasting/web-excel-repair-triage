{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prompt-improvement-candidate/v1",
  "title": "Prompt Improvement Candidate",
  "description": "Deterministic self-building proposal derived from recurrence evidence. Never self-authorizing; Git PR remains the promotion boundary.",
  "schema_version": "prompt-improvement-candidate/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "failure_identity",
    "evidence_refs",
    "affected_authority",
    "proposed_change",
    "required_regressions",
    "promotion_authority"
  ],
  "properties": {
    "schema_version": {"const": "prompt-improvement-candidate/v1"},
    "candidate_id": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^IC-[A-Za-z0-9._-]+$"},
    "failure_identity": {"type": "string", "minLength": 1, "maxLength": 160},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 240}
    },
    "affected_authority": {
      "type": "string",
      "enum": ["language-engine", "prompt-semantics", "execution-profile", "prompt-context", "fixtures"]
    },
    "proposed_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule"],
      "properties": {
        "rule": {"type": "string", "minLength": 1, "maxLength": 480},
        "semantic_delta_ref": {"type": "string", "minLength": 1, "maxLength": 240},
        "language_rule_delta_ref": {"type": "string", "minLength": 1, "maxLength": 240}
      }
    },
    "required_regressions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 120}
    },
    "promotion_authority": {"const": "reviewed_pr_only"}
  }
}
