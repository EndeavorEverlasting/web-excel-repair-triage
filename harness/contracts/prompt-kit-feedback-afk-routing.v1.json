{
  "schema_version": "prompt-kit-feedback-afk-routing/v1",
  "prompt_surface": "standard-ai",
  "mission": "Route explicit Prompt Kit feedback and privacy-bounded derived Operant friction into bounded AFK development work without giving browser telemetry, transport code, or a local coordinator independent merge authority.",
  "semantic_owners": {
    "explicit_feedback": "P99",
    "usage_and_friction_semantics": "P99",
    "afk_coordination": "P115",
    "general_repository_execution": "P07",
    "established_ci_repair": "P32",
    "promotion": "P105/pr-floor-integration"
  },
  "surfaces": {
    "browser_runtime": {
      "primary_surface": "conventional_application_logic",
      "path": "docs/prompt-kit-feedback-production.js",
      "owns": [
        "append-only browser-local explicit feedback",
        "explicit user consent for any future private loopback sync",
        "browser-local cursor state"
      ],
      "forbidden": [
        "GitHub credentials",
        "pull-request merge authority",
        "implicit historical upload when consent is enabled",
        "provider polling",
        "raw ordinary-usage export without a separate accepted privacy contract"
      ]
    },
    "friction_derivation": {
      "primary_surface": "P99-owned telemetry semantic boundary",
      "owns": [
        "deriving a coarse friction receipt from deterministic runtime failure or repeated local patterns",
        "keeping raw ordinary usage local and non-actionable",
        "dropping search text, typed content, navigation history, identity, URL, clipboard, and prompt body before AFK routing"
      ],
      "forbidden": [
        "raw session replay",
        "cross-user behavior profiling",
        "engagement optimization",
        "automatic promotion authority",
        "turning one ordinary click, copy, open, invoke, or favorite event into repository work"
      ]
    },
    "private_bridge": {
      "primary_surface": "integration_seam",
      "path": "scripts/prompt_kit_feedback_bridge.py",
      "owns": [
        "loopback request validation",
        "browser-source pseudonymization",
        "private local spool and retry receipts",
        "sanitized provider wakeup metadata when enabled"
      ],
      "forbidden": [
        "pull-request merge authority",
        "worker scheduling loop",
        "raw written feedback in provider dispatch payloads",
        "browser credential storage"
      ]
    },
    "afk_router": {
      "primary_surface": "agent_harness",
      "path": "scripts/prompt_kit_afk_signal_router.py",
      "owns": [
        "single-signal classification",
        "signal-id deduplication",
        "machine-readable work-request creation",
        "bounded invocation of one configured capable worker",
        "privacy-bounded Operant friction receipt admission"
      ],
      "forbidden": [
        "background polling loop",
        "provider PR scanning",
        "direct merge execution",
        "replacement of P115 or P105",
        "telemetry collection or friction derivation"
      ]
    },
    "provider_feedback_hook": {
      "primary_surface": "integration_seam",
      "paths": [
        "scripts/prompt_kit_feedback_hook.py",
        ".github/workflows/prompt-kit-feedback-hook.yml"
      ],
      "required_permissions": "contents:read",
      "mutation_authority": false
    },
    "remote_repository_dispatch_adapter": {
      "primary_surface": "provider_adapter",
      "path": "scripts/prompt_kit_afk_repository_dispatch.py",
      "workflow": ".github/workflows/prompt-kit-feedback-hook.yml",
      "event_type": "operant-friction-receipt",
      "owns": [
        "extracting only the sanitized repository_dispatch client_payload",
        "delegating one accepted friction receipt to the provider-neutral AFK router",
        "emitting bounded state/work-request evidence as a workflow artifact"
      ],
      "forbidden": [
        "raw browser telemetry collection",
        "provider identity propagation into work-request evidence",
        "worker polling",
        "direct pull-request mutation or merge",
        "pretending a canonical Operant upgrade engine exists before it is implemented"
      ],
      "required_permissions": "contents:read",
      "mutation_authority": false
    },
    "promotion": {
      "primary_surface": "harness_spine",
      "owner": "pr-floor-integration/P105",
      "contract": "harness/contracts/pr-merge-gate.v1.json",
      "validator": "scripts/validate_pr_merge_gate.py"
    }
  },
  "signal_classes": {
    "prompt_feedback": "ACTIONABLE_REPAIR",
    "prompt_vote:dislike": "ACTIONABLE_REPAIR",
    "prompt_vote:like": "INFORMATION_ONLY",
    "prompt_usage": "INFORMATION_ONLY",
    "operant_friction": "CONDITIONAL_ACTIONABLE_REPAIR"
  },
  "friction_policy": {
    "allowed_values": [
      "stale_guidance",
      "route_miss",
      "action_failure",
      "recovery_loop"
    ],
    "evidence_kinds": {
      "deterministic_runtime_failure": {
        "minimum_occurrences": 1
      },
      "repeated_local_pattern": {
        "minimum_occurrences": 3
      }
    },
    "required_fields": [
      "signal_id",
      "event_type",
      "value",
      "surface_id",
      "evidence_kind",
      "occurrence_count"
    ],
    "raw_usage_is_never_directly_actionable": true,
    "prompt_id_optional": true,
    "derivation_owner": "P99",
    "coordination_owner": "P115"
  },
  "privacy": {
    "browser_credentials": false,
    "raw_comment_provider_dispatch": false,
    "raw_comment_local_worker_request": true,
    "raw_usage_history_provider_dispatch": false,
    "raw_search_or_typed_content": false,
    "user_identity_in_friction_receipt": false,
    "friction_receipts_local_first": true,
    "provider_receipt_fields": [
      "schema_version",
      "signal_id",
      "prompt_id",
      "surface_id",
      "event_type",
      "value",
      "evidence_kind",
      "occurrence_count",
      "has_comment",
      "source_hash",
      "sequence",
      "timestamp"
    ]
  },
  "execution_adapters": {
    "contract": "Local workers and remote SCM/CI adapters consume the same sanitized signal/work-request semantics.",
    "provider_neutral_router": true,
    "github_actions_role": "worked adapter only",
    "github_actions_repository_dispatch_event": "operant-friction-receipt",
    "github_actions_adapter": "scripts/prompt_kit_afk_repository_dispatch.py",
    "github_actions_workflow": ".github/workflows/prompt-kit-feedback-hook.yml",
    "worker_boundary": "Without a configured provider-neutral worker argv, remote intake stops at a BLOCKED_WORKER_UNCONFIGURED work-request artifact and does not claim repository mutation.",
    "promotion_owner": "P105/pr-floor-integration",
    "second_scheduler_allowed": false
  },
  "wakeups": {
    "event_driven": [
      "accepted local feedback event",
      "accepted privacy-bounded Operant friction receipt",
      "sanitized repository_dispatch receipt"
    ],
    "schedule_role": "bounded recovery or revalidation only",
    "second_scheduler_allowed": false
  },
  "proof_levels": {
    "static": "Contract, registries, source boundaries, and generated-site parity on the tested commit.",
    "provider": "Observed workflow/check/review identities for the exact candidate only.",
    "browser_runtime": "Observed browser request/response and persistence behavior; static JavaScript assertions are insufficient.",
    "promotion": "P105/pr-floor exact-head validation and provider merge receipt; never inferred from the AFK router."
  }
}
