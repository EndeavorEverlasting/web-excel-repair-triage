{
  "schema_version": "prompt-kit-serverless-runtime-lifecycle/v1",
  "repository": "EndeavorEverlasting/web-excel-repair-triage",
  "default_branch": "main",
  "parent_contract": "harness/contracts/prompt-kit-cross-device-access.v1.json",
  "phase_plan": "docs/PROMPT_KIT_SERVERLESS_RUNTIME_PHASE_PLAN.md",
  "completed_floor": {
    "privacy_storage_pr": 460,
    "main_sha": "3e37127253c753a2e861f6171b4fa8aede43098e",
    "state": "integrated-and-validated"
  },
  "strategic_dependencies": {
    "post_phase_c_scout": "harness/prompt-topology/POST_PHASE_C_STRATEGIC_SCOUT.md",
    "required_before_phase_4": "Prompt Topology Phase C closeout integrated and P95 Prompt Execution Evidence Spine/state-ownership investigation resolved"
  },
  "architecture": {
    "deployment_model": "serverless-local-first",
    "private_plaintext_authority": "user-device",
    "prompt_kit_owned_always_on_server_required": false,
    "sync_model": "encrypted-client-side-capsule-over-user-selected-or-serverless-transport",
    "collective_learning_model": "privacy-reduced-local-aggregation-before-any-network-egress",
    "invariants": [
      "Durable personal state remains user-controlled and must never be deleted by telemetry cleanup.",
      "Telemetry, local journal, retry, polling, and reducer state must be bounded by both age and size or count.",
      "A network transport may be serverless, but it must not become an identity or raw-history backend.",
      "Polling and retry machinery may retain only the minimum state required to continue a bounded operation; request and response history is not a durable store.",
      "If lifecycle cleanup cannot prove storage remains within contract bounds, telemetry and sync writes stop before Personal State is sacrificed."
    ]
  },
  "runtime_capability_horizon": [
    {
      "id": "local-storage-separation-and-lifecycle",
      "status": "planned",
      "phase": 1,
      "required_use_cases": [
        "separate Personal State, Local Journal, PrivacyReducer buffer, sync retry state, and secrets",
        "automatic retention cleanup",
        "manual clear controls",
        "storage-pressure fail-closed behavior"
      ]
    },
    {
      "id": "encrypted-pkenc-export-import",
      "status": "planned",
      "phase": 2,
      "required_use_cases": [
        "positive-allowlist Sync Capsule serialization",
        "client-side encryption before transport",
        "portable import/export without raw Local Journal data"
      ]
    },
    {
      "id": "cross-device-pairing",
      "status": "planned",
      "phase": 2,
      "required_use_cases": [
        "user-controlled transfer of decryption capability",
        "no mandatory account identity",
        "pairing and recovery material never enters Collective Learning"
      ]
    },
    {
      "id": "serverless-sync-transport",
      "status": "planned",
      "phase": 3,
      "required_use_cases": [
        "automatic convenience without an always-on Prompt Kit server",
        "encrypted capsule only",
        "bounded retry and polling state",
        "delete-on-success and delete-on-expiry semantics"
      ]
    },
    {
      "id": "privacy-reducer-runtime",
      "status": "planned",
      "phase": 4,
      "required_use_cases": [
        "device-local aggregation",
        "privacy output allowlist",
        "bounded local aggregate buffer",
        "automatic purge after export, acknowledgement, or expiry"
      ]
    },
    {
      "id": "collective-learning-ingestion",
      "status": "planned",
      "phase": 5,
      "required_use_cases": [
        "serverless ingestion of privacy-reduced batches only",
        "no stable user, device, vault, session, project, or repository identity",
        "bounded server retention",
        "idempotent acknowledgement so local batches can be deleted"
      ]
    },
    {
      "id": "network-anonymity",
      "status": "investigate-first",
      "phase": 5,
      "required_use_cases": [
        "measure residual transport metadata",
        "evaluate relay, secure aggregation, differential privacy, or oblivious transport where justified",
        "do not claim anonymity from payload minimization alone"
      ]
    }
  ],
  "local_storage_lifecycle": {
    "versioned_profile": "storage-minimization-v1",
    "cleanup_engine_required": true,
    "cleanup_run_points": [
      "application-start",
      "after-local-journal-write",
      "after-reducer-buffer-write",
      "before-network-export-or-upload",
      "after-successful-export-or-acknowledgement",
      "manual-user-clear"
    ],
    "stores": {
      "personal_state": {
        "automatic_purge": false,
        "retention": "until-user-delete",
        "user_clear_required": true,
        "notes": "Favorites, collections, saved variants, preferences, tags, notes and workflows are durable user state, not telemetry."
      },
      "local_journal": {
        "max_age_days": 14,
        "max_bytes": 2097152,
        "eviction": "oldest-first",
        "delete_on": [
          "age-expiry",
          "size-pressure",
          "manual-user-clear",
          "schema-migration-when-record-cannot-be-safely-migrated"
        ]
      },
      "privacy_reducer_buffer": {
        "max_age_days": 30,
        "max_bytes": 524288,
        "max_aggregate_keys": 2048,
        "eviction": "oldest-or-lowest-value-aggregate-first",
        "delete_on": [
          "successful-export-or-ingestion-acknowledgement",
          "age-expiry",
          "size-pressure",
          "manual-user-clear"
        ]
      },
      "sync_retry_queue": {
        "max_age_days": 7,
        "max_bytes": 262144,
        "max_items": 64,
        "delete_on": [
          "successful-transport",
          "permanent-failure",
          "age-expiry",
          "size-pressure",
          "transport-disabled",
          "manual-user-clear"
        ]
      },
      "polling_state": {
        "persistent_request_history_allowed": false,
        "persistent_response_history_allowed": false,
        "persistent_cycle_log_allowed": false,
        "max_persistent_cursor_records": 1,
        "backoff_state": "ephemeral-preferred",
        "delete_on": [
          "successful-cycle",
          "transport-disabled",
          "cursor-invalidated",
          "manual-user-clear"
        ]
      }
    },
    "storage_pressure_policy": {
      "priority": [
        "delete expired polling and retry state",
        "delete acknowledged reducer aggregates",
        "evict expired Local Journal records",
        "evict oldest reducer aggregates within bounds",
        "stop telemetry and sync writes"
      ],
      "must_never_auto_delete": [
        "Personal State",
        "encryption keys or recovery material required to decrypt an existing user save"
      ]
    },
    "user_controls": {
      "clear_usage_and_local_journal_required": true,
      "clear_collective_buffer_required": true,
      "clear_sync_retry_and_polling_state_required": true,
      "clear_personal_state_must_be_separate": true,
      "clear_personal_state_confirmation_required": true
    }
  },
  "polling_and_telemetry_policy": {
    "network_polling_default": "disabled-until-transport-phase",
    "polling_history_is_telemetry": false,
    "persist_poll_request_or_response_bodies": false,
    "persist_exact_poll_timestamps": false,
    "retry_queue_is_not_a_history_log": true,
    "telemetry_write_requires_cleanup_pass": true,
    "delete_local_batch_after_positive_acknowledgement": true,
    "offline_behavior": "continue local product use without growing an unbounded outbound queue"
  },
  "phase_map": {
    "phase-1-local-lifecycle": {
      "status": "planned",
      "dependency": "privacy/storage contract integrated on main",
      "owned_scope": [
        "local storage adapter and logical store separation",
        "retention and purge engine",
        "manual clear controls",
        "bounded usage/preference storage",
        "storage-pressure tests"
      ],
      "forbidden_scope": [
        "network transport",
        "hosted or serverless ingestion",
        "cryptographic export/import",
        "cross-device pairing"
      ],
      "expected_artifacts": [
        "repository-native local lifecycle implementation",
        "runtime tests proving age/size/count eviction",
        "user-clear path",
        "generated Prompt Kit parity when the runtime is wired"
      ],
      "acceptance_gates": [
        "no unbounded append-only telemetry store",
        "usage/history state exposes a reachable clear operation",
        "Personal State survives automatic telemetry cleanup",
        "storage-pressure failure stops telemetry writes before deleting Personal State"
      ]
    },
    "phase-2-portable-private-sync": {
      "status": "planned",
      "dependency": "phase-1-local-lifecycle",
      "owned_scope": [
        "promptkit-save.pkenc export/import",
        "client-side encryption",
        "cross-device pairing and recovery UX"
      ],
      "forbidden_scope": [
        "automatic cloud transport",
        "Collective Learning ingestion"
      ]
    },
    "phase-3-serverless-sync-transport": {
      "status": "planned",
      "dependency": "phase-2-portable-private-sync",
      "owned_scope": [
        "automatic transport adapter",
        "bounded polling/retry state",
        "delete-on-success and expiry behavior"
      ],
      "forbidden_scope": [
        "raw Local Journal upload",
        "identity-backed analytics"
      ]
    },
    "phase-4-local-collective-learning": {
      "status": "planned",
      "dependency": "phase-1-local-lifecycle plus Prompt Topology Phase C closeout plus resolved P95 evidence-spine/state-ownership investigation",
      "owned_scope": [
        "PrivacyReducer runtime",
        "bounded local aggregate buffer",
        "privacy-reduced batch export"
      ],
      "forbidden_scope": [
        "network ingestion before local privacy/runtime proof",
        "new route/usage/outcome event model before evidence-spine ownership is resolved"
      ]
    },
    "phase-5-serverless-collective-ingestion": {
      "status": "planned",
      "dependency": "phase-4-local-collective-learning plus network-anonymity investigation",
      "owned_scope": [
        "serverless ingestion endpoint",
        "bounded server retention",
        "acknowledgement/idempotency contract",
        "transport-metadata evaluation"
      ],
      "forbidden_scope": [
        "stable user/device/session/vault identifiers",
        "raw prompt, project, repository or conversation content"
      ]
    }
  },
  "known_runtime_collision": {
    "pull_request": 242,
    "surface": "docs/prompt-kit-preference-gameplay.js",
    "observed_store": "promptKit.usage.v1",
    "observed_bounded_behavior": "recent prompt ids are capped at 12 and per-prompt state is keyed by finite Prompt Canon ids",
    "required_reconciliation_before_merge": "provide a reachable user-clear/delete operation for local usage state and remain compatible with the lifecycle bounds"
  }
}
