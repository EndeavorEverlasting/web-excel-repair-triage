  ],
  "deferred_attribute": "data-ui-format-deferred",
  "role_attribute": "data-ui-format-role",
  "validation": {
    "harness_command": "python scripts/validate_prompt_kit_ui_format_alignment.py --summary",
    "strict_product_gate": "python scripts/validate_prompt_kit_ui_format_alignment.py --require-implementation --summary",
    "contract_tests": "python -m unittest tests.test_prompt_kit_ui_format_alignment -v",
    "exact_site_parity": "python scripts/build_prompt_kit_registry.py --output web/prompt-kit/index.html --check",
    "protected_storage_runtime": "python -m unittest tests.test_prompt_kit_storage_lifecycle_runtime -v",
    "protected_header_contract": "python tests/test_prompt_kit_header_contract.py"
  },
  "proof_ceiling": "Static source and ledger proof that interactive Prompt Kit controls are catalog-aligned or explicitly deferred. Does not by itself prove pixel-perfect browser styling until a live header neighbor check is observed."
}
