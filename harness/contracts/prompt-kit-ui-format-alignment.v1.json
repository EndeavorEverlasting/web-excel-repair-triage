  ],
  "header_utility_required_class": "operant-resource-button",
  "header_utility_control_ids": [
    "promptStorageLifecycleBtn",
    "externalResourcesButton"
  ],
  "scan_paths": [
    "docs/prompt-kit-storage-lifecycle.js",
    "docs/prompt-kit-external-resources.js",
    "docs/prompt-kit-guided-recommendations.js",
    "docs/prompt-kit.js",
