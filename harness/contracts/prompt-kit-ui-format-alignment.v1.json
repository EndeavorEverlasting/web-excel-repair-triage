{
  "schema_version": "prompt-kit-ui-format-alignment/v1",
  "contract_id": "prompt-kit-ui-format-alignment",
  "status": "implemented",
  "surface": {
    "canonical_site": "web/prompt-kit/index.html",
    "canonical_runtime_sources": [
      "docs/prompt-kit*.js",
      "build_prompt_kit.py"
    ],
    "combined_builder": "scripts/build_prompt_kit_registry.py",
    "ledger": "harness/prompt-kit-ui-format-alignment/ledger.v1.json"
  },
  "owner": {
    "workflow": "WORKFLOW.md#b-prompt-registry-or-website-change",
    "implementation_lane": "Prompt Kit UI format alignment",
    "forbidden_in_harness_lane": [
      "unrelated product redesign",
      "hand-editing generated web/prompt-kit/index.html"
    ]
  },
  "requirements": [
    {
      "id": "every_visible_control_uses_catalog_class",
      "expected": "Interactive controls that modify the Prompt Kit view must use at least one allowed class from this contract's class catalog (or a registered family prefix).",
      "forbidden": "Shipping bare browser-default chrome (for example className='btn') or inventing one-off class tokens that are not in the catalog."
    },
    {
      "id": "unaligned_controls_must_be_deferred",
      "expected": "If a control cannot yet use a catalog class, it must declare data-ui-format-deferred=\"<ledger-id>\" and appear in the deferred ledger with owner, reason, and next action.",
      "forbidden": "Leaving unclassed or forbidden-class UI live without a deferred ledger entry."
    },
    {
      "id": "header_utility_neighbors_share_sequence",
      "expected": "Controls mounted into .header-controls that are secondary utilities (Storage, Resources) must use the header-utility class operant-resource-button and remain visually sequenced with neighboring header controls.",
      "forbidden": "Header utility mounts that fall out of the formatting sequence of Add Prompt, Tutorial, stats, and Resources."
    },
    {
      "id": "deferred_ledger_is_pr_fodder",
      "expected": "Deferred ledger rows are actionable repair targets for agents and developers; aligned rows prove current catalog compliance.",
      "forbidden": "Deleting deferred rows to silence the validator without repairing or consciously retiring the control."
    }
  ],
  "forbidden_classes": [
    "btn",
    "button",
    "modal",
    "modal-content",
    "modal-actions"
  ],
  "allowed_classes": [
    "add-prompt-btn",
    "finder-prompt-btn",
    "operant-resource-button",
    "operant-resource-close",
    "operant-resource-page",
    "operant-resource-prev",
    "operant-resource-next",
    "cat-tab",
    "section-tab",
    "section-toggle",
    "sd-label",
    "prompt-favorite-btn",
    "prompt-open-btn",
    "prompt-copy-btn",
    "prompt-detail-close",
    "prompt-detail-favorite-btn",
    "doctrine-back",
    "ref-toggle",
    "filter-panel-toggle",
    "favorites-empty-action",
    "mobile-favorites-quick",
    "mobile-prompt-jump-toggle",
    "mobile-prompt-jump-go",
    "mobile-quick-action",
    "hotkey-help-toggle",
    "hotkey-help-close",
    "hotkey-shortcut-remove",
    "ontology-tab",
    "ontology-lens",
    "ontology-link",
    "prompt-storage-action",
    "prompt-storage-backdrop",
    "prompt-storage-panel",
    "prompt-storage-actions",
    "profile-slot",
    "page-jump",
    "guide-next-card",
    "guide-action",
    "pd-copy",
    "pk-feedback-vote"
  ],
  "allowed_class_prefixes": [
    "operant-resource-",
    "prompt-storage-",
    "prompt-profile-",
    "prompt-feedback-",
