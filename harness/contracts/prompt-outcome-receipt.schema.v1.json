{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prompt-outcome-receipt/v1",
  "title": "Prompt Outcome Receipt",
  "description": "Append-only bounded evidence receipt for one observed Prompt Kit invocation outcome. Interaction divergence is scoped to one grounding episode and derived only from explicit correction events, never ordinary prompt usage.",
  "schema_version": "prompt-outcome-receipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "invocation", "observer", "observation", "result", "classification", "evidence", "occurred_at"],
  "properties": {
    "schema_version": {"const": "prompt-outcome-receipt/v1"},
    "receipt_id": {"$ref": "#/$defs/id"},
    "supersedes_receipt_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "related_receipt_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "invocation": {"$ref": "#/$defs/invocation"},
    "observer": {"$ref": "#/$defs/observer"},
    "observation": {"$ref": "#/$defs/observation"},
    "result": {"type": "string", "enum": ["SUCCESS", "PARTIAL", "FAILURE", "BLOCKED", "UNKNOWN"]},
    "classification": {"$ref": "#/$defs/classification"},
    "evidence": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/evidence"}},
    "interaction": {"oneOf": [{"$ref": "#/$defs/interaction"}, {"type": "null"}]},
    "state_transition": {"oneOf": [{"$ref": "#/$defs/state_transition"}, {"type": "null"}]},
    "next_state": {"oneOf": [{"$ref": "#/$defs/next_state"}, {"type": "null"}]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "retrospective": {"type": "boolean", "default": false}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._:/-]+$"},
    "short_text": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\r\\n]+$"},
    "bounded_summary": {"type": "string", "minLength": 1, "maxLength": 320, "pattern": "^[^\\r\\n]+$"},
    "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/?#@&=+%~-]*$"},
    "prompt_id": {"type": "string", "pattern": "^P[0-9]{2,4}$"},
    "evidence_state": {"type": "string", "enum": ["PLANNED_DESIGNED", "TRACKED", "IMPLEMENTED", "WIRED_REACHABLE", "VALIDATED", "INTEGRATED", "DEPLOYED", "OBSERVED"]},
    "failure_class": {"type": "string", "enum": ["routing", "interpretation", "execution", "progression", "durability", "premature-terminal", "evidence-promotion", "regression", "environment", "unknown"]},
    "cause_family": {"type": "string", "enum": ["grounding", "intent-fidelity", "decomposition", "contract-fidelity", "action-space", "recovery", "unknown"]},
    "intervention": {"type": "string", "enum": ["CONTINUE", "CRITIQUE", "REGROUND", "REBOOTSTRAP"]},
    "correction_action_kind": {"type": "string", "enum": ["corrective_repeat_request", "explicit_correction", "restate_context", "restate_constraint", "reroute_owner", "reenumerate_work", "manual_workaround", "manual_context_transfer", "restart_conversation", "abandon"]},
    "invocation": {
      "type": "object", "additionalProperties": false,
      "required": ["invocation_id", "prompt_id", "prompt_revision", "surface_id"],
      "properties": {
        "invocation_id": {"$ref": "#/$defs/id"},
        "prompt_id": {"$ref": "#/$defs/prompt_id"},
        "prompt_revision": {"$ref": "#/$defs/short_text"},
        "surface_id": {"$ref": "#/$defs/short_text"},
        "mission_id": {"oneOf": [{"$ref": "#/$defs/short_text"}, {"type": "null"}]},
        "target_runtime": {"oneOf": [{"$ref": "#/$defs/short_text"}, {"type": "null"}]},
        "repository": {"oneOf": [{"$ref": "#/$defs/short_text"}, {"type": "null"}]}
      }
    },
    "observer": {
      "type": "object", "additionalProperties": false,
      "required": ["observer_id", "kind", "surface_id"],
      "properties": {
        "observer_id": {"$ref": "#/$defs/id"},
        "kind": {"type": "string", "enum": ["user", "agent", "repository", "provider", "runtime", "validator", "reviewer", "system"]},
        "surface_id": {"$ref": "#/$defs/short_text"}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "summary"],
      "properties": {
        "type": {"type": "string", "enum": ["natural_usage", "repository", "provider", "runtime", "explicit_feedback", "derived"]},
        "summary": {"$ref": "#/$defs/bounded_summary"},
        "expected_state": {"oneOf": [{"$ref": "#/$defs/short_text"}, {"type": "null"}]},
        "observed_state": {"oneOf": [{"$ref": "#/$defs/short_text"}, {"type": "null"}]},
        "claimed_state": {"oneOf": [{"$ref": "#/$defs/short_text"}, {"type": "null"}]},
        "signal_ids": {"type": "array", "uniqueItems": true, "maxItems": 64, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "classification": {
      "type": "object", "additionalProperties": false,
      "required": ["primary", "secondary", "confidence", "attribution", "actionability", "rationale"],
      "properties": {
        "primary": {"oneOf": [{"$ref": "#/$defs/failure_class"}, {"type": "null"}]},
        "secondary": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/failure_class"}},
        "confidence": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW", "NONE"]},
        "attribution": {"type": "string", "enum": ["PROVEN", "CORRELATED", "UNOBSERVED"]},
        "actionability": {"type": "string", "enum": ["INFORMATION_ONLY", "REVIEW_CANDIDATE", "CONDITIONAL_ACTIONABLE_REPAIR", "ACTIONABLE_REPAIR"]},
        "rationale": {"$ref": "#/$defs/bounded_summary"}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "ref", "supports"],
      "properties": {
        "kind": {"type": "string", "enum": ["repository", "validator", "runtime", "provider", "user_feedback", "usage_pattern", "artifact", "other"]},
        "ref": {"$ref": "#/$defs/evidence_ref"},
        "supports": {"$ref": "#/$defs/bounded_summary"}
      }
    },
    "correction_event": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "grounding_episode_id", "kind", "corrective"],
      "properties": {
        "event_id": {"$ref": "#/$defs/id"},
        "grounding_episode_id": {"$ref": "#/$defs/id"},
        "kind": {"$ref": "#/$defs/correction_action_kind"},
        "corrective": {"const": true},
        "signal_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "occurred_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]}
      }
    },
    "interaction": {
      "type": "object", "additionalProperties": false,
      "required": ["grounding_episode_id", "response_relevance", "correction_events", "correction_burden", "interaction_yield", "divergence_pressure", "cause_candidates", "intervention"],
      "properties": {
        "grounding_episode_id": {"$ref": "#/$defs/id"},
        "response_relevance": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "correction_events": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/correction_event"}},
        "correction_burden": {"type": "number", "minimum": 0.0, "maximum": 100.0},
        "interaction_yield": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "divergence_pressure": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "cause_candidates": {"type": "array", "uniqueItems": true, "maxItems": 7, "items": {"$ref": "#/$defs/cause_family"}},
        "intervention": {"$ref": "#/$defs/intervention"}
      }
    },
    "state_transition": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {"from": {"$ref": "#/$defs/evidence_state"}, "to": {"$ref": "#/$defs/evidence_state"}}
    },
    "next_state": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "action", "completion_gate"],
      "properties": {
        "owner": {"$ref": "#/$defs/short_text"},
        "action": {"$ref": "#/$defs/bounded_summary"},
        "completion_gate": {"$ref": "#/$defs/bounded_summary"}
      }
    }
  }
}
