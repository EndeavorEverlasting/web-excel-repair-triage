{
  "schema_version": "prompt-parallel-dispatch-contract/v1",
  "manifest_schema": "prompt-parallel-dispatch/v1",
  "receipt_schema": "prompt-parallel-dispatch-receipt/v1",
  "default_manifest_path": "Outputs/prompt-parallel-dispatch/manifest.json",
  "default_receipt_path": "Outputs/prompt-parallel-dispatch/receipt.json",
  "adapter_ladder": [
    {
      "rung": 1,
      "kind": "native_agent",
      "launch_modes": ["runtime_tool", "argv"]
    },
    {
      "rung": 2,
      "kind": "repo_runner",
      "launch_modes": ["argv", "runtime_tool"]
    },
    {
      "rung": 3,
      "kind": "connected_provider",
      "launch_modes": ["runtime_tool", "argv"]
    },
    {
      "rung": 4,
      "kind": "ci_job",
      "launch_modes": ["argv", "runtime_tool"]
    },
    {
      "rung": 5,
      "kind": "local_process",
      "launch_modes": ["argv"]
    }
  ],
  "parallel_dispositions": [
    "REQUIRED",
    "NOT_APPLICABLE",
    "DEGRADED"
  ],
  "lane_statuses": [
    "PLANNED",
    "DISPATCHED",
    "PASS",
    "FAIL",
    "BLOCKED"
  ],
  "required_manifest_fields": [
    "schema_version",
    "run_id",
    "graph_width",
    "parallel_disposition",
    "autonomy_gap",
    "lanes"
  ],
  "required_lane_fields": [
    "lane_id",
    "mission",
    "dependencies",
    "owned_mutation_surfaces",
    "forbidden_surfaces",
    "adapter",
    "launch",
    "expected_artifacts",
    "validation",
    "convergence_owner",
    "status"
  ],
  "launch_modes": {
    "argv": {
      "required": ["mode", "argv"],
      "optional": ["cwd", "timeout_seconds"]
    },
    "runtime_tool": {
      "required": ["mode", "tool", "operation", "arguments"],
      "rule": "The active agent runtime must perform the named tool/API invocation and preserve returned evidence in a receipt; the repository CLI validates but cannot impersonate unavailable runtime tools."
    }
  },
  "policy": {
    "graph_width_one_disposition": "NOT_APPLICABLE",
    "parallel_width_disposition": "REQUIRED",
    "all_adapters_exhausted_disposition": "DEGRADED",
    "degraded_requires_autonomy_gap": true,
    "parallel_success_requires_observed_dispatch": true,
    "human_scheduler_allowed": false,
    "shared_mutation_surface_requires_dependency_order": true,
    "deterministic_ready_lane_tiebreak": "lane_id_ascending",
    "prohibited_clean_fallback": "PARALLEL EXECUTION: unavailable"
  },
  "proof_ceiling": "Validates a machine-readable dependency/collision/adapter/launch contract and can execute argv-addressable lanes in concurrent dependency waves. Runtime-tool adapters remain externally dispatched by the active agent runtime and require separate evidence receipts."
}
