{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prompt-semantics/v1",
  "title": "Prompt Semantic IR",
  "description": "Canonical semantic authority underneath English prompt prose. Obligations, modalities, and invariants are machine-checkable.",
  "schema_version": "prompt-semantics/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "prompt_id", "goal", "obligations", "invariants"],
  "properties": {
    "schema_version": {"const": "prompt-semantics/v1"},
    "prompt_id": {"type": "string", "pattern": "^P[0-9]{2,4}$"},
    "goal": {"type": "string", "minLength": 1, "maxLength": 480},
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/obligation"}
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 120}
    }
  },
  "$defs": {
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "when", "modality", "action", "proof", "failure_state"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9._-]+$"},
        "when": {"type": "string", "minLength": 1, "maxLength": 240},
        "modality": {"type": "string", "enum": ["MUST", "SHOULD", "MAY"]},
        "action": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[A-Za-z0-9._-]+$"},
        "proof": {"type": "string", "minLength": 1, "maxLength": 160},
        "failure_state": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Z][A-Z0-9_]*$"}
      }
    }
  }
}
