{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "live-thread-p02-checkpoint/v1",
  "title": "Live Thread-Convergence to P02 Checkpoint",
  "description": "Machine-checkable durable handoff from the live thread-convergence controller to P02. Structure is strict; scripts/validate_conversation_handoff_checkpoint.py owns cross-field semantic validation.",
  "schema_version": "live-thread-p02-checkpoint/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["handoff_version", "source_controller", "source_conversation_state", "created_at", "threads"],
  "properties": {
    "handoff_version": {"const": "live-thread-p02-checkpoint/v1"},
    "source_controller": {"const": "live-thread-convergence-controller"},
    "source_conversation_state": {"type": "string", "enum": ["ACTIVE", "DEGRADED", "CLOSING", "TERMINAL"]},
    "created_at": {"type": "string", "format": "date-time"},
    "threads": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/thread"}}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "priority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "rationale"],
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "rationale": {"$ref": "#/$defs/nonempty"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "status", "evidence"],
      "properties": {
        "decision": {"$ref": "#/$defs/nonempty"},
        "status": {"type": "string", "enum": ["SETTLED", "PROVISIONAL", "REOPEN ONLY IF EVIDENCE CHANGES"]},
        "evidence": {"$ref": "#/$defs/nonempty"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "identity", "value", "mutable"],
      "properties": {
        "type": {"type": "string", "enum": ["conversation", "repository", "artifact", "file", "runtime", "external-system", "other"]},
        "identity": {"$ref": "#/$defs/nonempty"},
        "value": {"$ref": "#/$defs/nonempty"},
        "mutable": {"type": "boolean"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "target", "result"],
      "properties": {
        "check": {"$ref": "#/$defs/nonempty"},
        "target": {"$ref": "#/$defs/nonempty"},
        "result": {"type": "string", "enum": ["PASS", "FAIL", "UNKNOWN", "SKIPPED"]},
        "evidence": {"type": ["string", "null"]}
      }
    },
    "remaining_work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "status", "dependency", "consequence"],
      "properties": {
        "item": {"$ref": "#/$defs/nonempty"},
        "status": {"type": "string", "enum": ["SAFE & EXECUTABLE", "BLOCKED", "USER-ONLY", "OUT OF SCOPE", "UNKNOWN"]},
        "dependency": {"$ref": "#/$defs/nonempty"},
        "consequence": {"$ref": "#/$defs/nonempty"}
      }
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "dependency", "action", "expected_output", "completion_gate"],
      "properties": {
        "owner": {"$ref": "#/$defs/nonempty"},
        "dependency": {"$ref": "#/$defs/nonempty"},
        "action": {"$ref": "#/$defs/nonempty"},
        "expected_output": {"$ref": "#/$defs/nonempty"},
        "completion_gate": {"$ref": "#/$defs/nonempty"}
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_blocker", "unblock_owner", "unblocking_action", "resume_trigger", "resume_point"],
      "properties": {
        "exact_blocker": {"$ref": "#/$defs/nonempty"},
        "unblock_owner": {"$ref": "#/$defs/nonempty"},
        "unblocking_action": {"$ref": "#/$defs/nonempty"},
        "resume_trigger": {"$ref": "#/$defs/nonempty"},
        "resume_point": {"$ref": "#/$defs/nonempty"}
      }
    },
    "repository_state": {
      "type": "object",
      "additionalProperties": true,
      "required": ["repository", "default_branch", "working_branch", "head_sha", "first_unproven_repository_gate"],
      "properties": {
        "repository": {"$ref": "#/$defs/nonempty"},
        "default_branch": {"$ref": "#/$defs/nonempty"},
        "working_branch": {"$ref": "#/$defs/nonempty"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
        "base_sha": {"type": ["string", "null"]},
        "pr": {"type": ["string", "null"]},
        "integration_sha": {"type": ["string", "null"]},
        "current_default_sha": {"type": ["string", "null"]},
        "changed_files": {"type": "array", "items": {"type": "string"}},
        "artifacts": {"type": "array", "items": {"type": "string"}},
        "overlap": {"type": "array", "items": {"type": "string"}},
        "dirty_state": {"type": ["string", "null"]},
        "first_unproven_repository_gate": {"$ref": "#/$defs/nonempty"}
      }
    },
    "thread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "disposition", "priority", "current_state", "last_meaningful_action", "first_unproven_gate", "decisions", "evidence", "changed_surfaces", "validations", "remaining_work", "next_action", "route", "return_trigger"],
      "properties": {
        "id": {"$ref": "#/$defs/nonempty"},
        "target": {"$ref": "#/$defs/nonempty"},
        "disposition": {"type": "string", "enum": ["COMPLETE", "BLOCKED", "HANDOFF-READY", "SUSPENDED", "SUPERSEDED"]},
        "priority": {"$ref": "#/$defs/priority"},
        "current_state": {"$ref": "#/$defs/nonempty"},
        "last_meaningful_action": {"$ref": "#/$defs/nonempty"},
        "first_unproven_gate": {"type": ["string", "null"]},
        "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "changed_surfaces": {"type": "array", "items": {"type": "string"}},
        "validations": {"type": "array", "items": {"$ref": "#/$defs/validation"}},
        "remaining_work": {"type": "array", "items": {"$ref": "#/$defs/remaining_work"}},
        "next_action": {"oneOf": [{"$ref": "#/$defs/next_action"}, {"type": "null"}]},
        "route": {"type": "string", "enum": ["RESUME IN NEW CONVERSATION", "ROUTE TO P07", "ROUTE TO DOMAIN OWNER", "USER ACTION THEN RESUME", "ARCHIVE ONLY", "NO CONTINUATION REQUIRED"]},
        "return_trigger": {"type": ["string", "null"]},
        "blocker": {"$ref": "#/$defs/blocker"},
        "repository_state": {"$ref": "#/$defs/repository_state"}
      }
    }
  }
}
