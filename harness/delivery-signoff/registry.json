{
  "schema": "triage-delivery-signoff-harness/v1",
  "as_of": "2026-08-05",
  "authority": "artifact_generation_layout_and_validation",
  "components": {
    "codebase_map": "harness/delivery-signoff/CODEBASE_MAP.md",
    "workflows": "harness/delivery-signoff/WORKFLOWS.md",
    "artifact_registry": "harness/delivery-signoff/ARTIFACT_REGISTRY.md",
    "layout_config": "configs/delivery_signoff_layout_v1.json",
    "skill": "skills/delivery-signoff-generation/SKILL.md",
    "capability": "capabilities/delivery-signoff-generation.json",
    "trigger": "triggers/delivery-signoff-generation.json",
    "validator": "scripts/validate_delivery_signoff_harness.py",
    "hook": ".githooks/pre-commit-delivery-signoff",
    "ci": ".github/workflows/delivery-signoff-harness.yml",
    "operator_report": "reports/harness/delivery-signoff-state.md"
  },
  "runtime": {
    "package": "triage/delivery_signoff/",
    "cli": "scripts/generate_delivery_signoff.py",
    "trigger_evaluator": "scripts/evaluate_delivery_signoff_trigger.py",
    "ci": ".github/workflows/delivery-signoff-generator.yml",
    "acceptance_tests": "tests/test_delivery_signoff_generator.py",
    "trigger_tests": "tests/test_delivery_signoff_trigger.py",
    "fixtures": "tests/fixtures/delivery_signoff/"
  },
  "upstream": {
    "repository": "EndeavorEverlasting/FUN",
    "spec_schema": "delivery-signoff-spec/v1",
    "source_authority": "FUN remains authoritative for evidence, provenance, quantities, serial lists, chronology, and unresolved fields."
  },
  "artifacts": {
    "docx": "Outputs/delivery-signoff/<run-root>/<site>/<signoff-id>/<SITE>_Delivery_Sign_Off_<id>_SERIAL_FIRST_INK_READY.docx",
    "preview": "Outputs/delivery-signoff/<run-root>/<site>/<signoff-id>/preview/",
    "manifest": "Outputs/delivery-signoff/<run-root>/<site>/<signoff-id>/delivery-signoff-artifact-manifest.json",
    "validation": "Outputs/delivery-signoff/<run-root>/<site>/<signoff-id>/delivery-signoff-validation.txt",
    "backup": "Outputs/backups/delivery-signoff/<site>/<signoff-id>/<timestamp-id>/"
  },
  "commands": {
    "generate": "python scripts/generate_delivery_signoff.py <spec.json> --output-root Outputs/delivery-signoff/<new-run-root>",
    "focused": "python scripts/validate_delivery_signoff_harness.py",
    "manifest": "python scripts/validate_delivery_signoff_harness.py --manifest <canonical-package>/delivery-signoff-artifact-manifest.json",
    "acceptance_tests": "python -m pytest -q tests/test_delivery_signoff_generator.py tests/test_delivery_signoff_harness_validator.py tests/test_delivery_signoff_trigger.py",
    "patch_hygiene": "git diff --check"
  },
  "proof_ceiling": "Static generation, rendering, evidence reconciliation, backup, and manifest validation do not prove Word pen input or operator acceptance."
}
