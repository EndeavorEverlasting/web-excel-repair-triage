{
  "schema_version": "compute-authority-agent-adapter-contract/v2",
  "config_schema_version": "compute-authority-agent-adapter/v1",
  "capture_schema_version": "compute-authority-provider-capture/v2",
  "rationale": "Separate neutral structural telemetry from evaluative annotation. Provider output must not self-grade usefulness, semantic first-green sufficiency, true fixed point, contract correctness, or treatment effectiveness. P67 derives evaluator labels from workspace mutation, validators, contract evidence, and manifests.",
  "execution": {
    "mode": "argv",
    "shell": false,
    "result_transport": "temporary_json_file",
    "stdout_stderr_persistence": "forbidden",
    "allowed_placeholders": [
      "workspace",
      "task",
      "prompt",
      "result"
    ],
    "default_timeout_seconds": 900,
    "max_timeout_seconds": 7200,
    "environment": "minimal_os_plus_explicit_allowlist",
    "launch_errors": "invalid_run_receipt"
  },
  "capture": {
    "top_level_allowed": [
      "schema_version",
      "provider",
      "agent",
      "model",
      "status",
      "termination_reason",
      "usage",
      "events",
      "validations"
    ],
    "required": [
      "schema_version",
      "provider",
      "status",
      "termination_reason",
      "events"
    ],
    "status_required": "complete",
    "minimum_runtime_evidence": "at_least_one_action_event",
    "usage_allowed": [
      "tool_calls",
      "retries",
      "input_tokens",
      "output_tokens",
      "total_tokens",
      "cost_microusd",
      "latency_ms"
    ],
    "event_allowed": [
      "id",
      "kind",
      "category",
      "action_index",
      "started_ns",
      "ended_ns",
      "hypothesis_id",
      "validation_id",
      "result_code",
      "child_lane_id"
    ],
    "event_kinds": [
      "action",
      "hypothesis_test",
      "validation_run",
      "child_lane",
      "termination"
    ],
    "event_categories": [
      "read",
      "write",
      "execute",
      "search",
      "analysis",
      "test",
      "unknown"
    ],
    "event_invariants": [
      "event ids are unique",
      "action indexes are positive, unique, and increase in event order",
      "category is optional but must be from event_categories when present"
    ],
    "validation_allowed": [
      "id",
      "command",
      "return_code",
      "started_ns",
      "ended_ns"
    ],
    "forbidden_evaluative_fields": [
      "useful",
      "first_green",
      "after_fixed_point",
      "correct",
      "seeded_defects_found",
      "contracts",
      "outcomes"
    ],
    "forbidden_key_tokens": [
      "prompt",
      "response",
      "clipboard",
      "transcript",
      "content",
      "text",
      "query",
      "user_id",
      "session_id",
      "identity"
    ],
    "free_text_payloads": "forbidden"
  },
  "workspace_evidence": {
    "mode": "pristine_vs_run_workspace_hash_manifest",
    "raw_file_content_persisted": false,
    "scope_diff": "changed_paths_only",
    "required_before_grading": true
  },
  "pairing": {
    "identity_fields": [
      "provider",
      "agent",
      "model"
    ],
    "mismatch_disposition": "invalidate_both_pair_members"
  },
  "invalid_run_codes": [
    "RUNTIME_UNAVAILABLE",
    "ADAPTER_CONFIG_INVALID",
    "ADAPTER_EXIT_NONZERO",
    "ADAPTER_LAUNCH_ERROR",
    "ADAPTER_RESULT_MISSING",
    "ADAPTER_RESULT_INVALID",
    "CAPTURE_PRIVACY_REJECTED",
    "CAPTURE_EVALUATIVE_REJECTED",
    "ADAPTER_TIMEOUT",
    "EVIDENCE_INCOMPLETE",
    "PAIR_IDENTITY_MISMATCH"
  ],
  "proof_boundary": "Repository/runtime-harness behavior only. External-agent effectiveness requires observed provider runs and cannot be inferred from fake/local adapters."
}
