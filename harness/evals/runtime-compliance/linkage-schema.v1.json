{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prompt-runtime-compliance-linkage-record/v1",
  "title": "Prompt Runtime Compliance Linkage Record",
  "schema_version": "prompt-runtime-compliance-linkage-record/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "compliance_receipt_id",
    "scenario_id",
    "validation_result",
    "p99_result_candidate",
    "p99_evidence_candidate",
    "failure_class_hints",
    "source_violation_ids",
    "rule_ids",
    "evidence_refs",
    "regression",
    "privacy"
  ],
  "properties": {
    "schema_version": {
      "const": "prompt-runtime-compliance-linkage-record/v1"
    },
    "compliance_receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "validation_result": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "INCONCLUSIVE"
      ]
    },
    "p99_result_candidate": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "PARTIAL",
        "FAILURE",
        "BLOCKED",
        "UNKNOWN"
      ]
    },
    "p99_evidence_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "supports"
      ],
      "properties": {
        "kind": {
          "const": "validator"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/?#@&=+%~-]*$"
        },
        "supports": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320,
          "pattern": "^[^\\r\\n]+$"
        }
      }
    },
    "failure_class_hints": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "routing",
          "interpretation",
          "execution",
          "progression",
          "durability",
          "premature-terminal",
          "evidence-promotion",
          "regression",
          "environment",
          "unknown"
        ]
      }
    },
    "source_violation_ids": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[A-Za-z0-9._:/-]+$"
      }
    },
    "rule_ids": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^PRCR\\.[A-Z0-9_.]+$"
      }
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[A-Za-z0-9._:/-]+$"
      }
    },
    "regression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "family",
        "occurrences",
        "systemic_threshold",
        "recurring_process_owner",
        "regression_design_owner"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "NONE",
            "CANDIDATE",
            "SYSTEMIC"
          ]
        },
        "family": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "RUNTIME_BEHAVIOR",
                "PATCH_HYGIENE",
                "PROOF_INTEGRITY",
                "PRIVACY",
                "REGRESSION",
                "SCHEMA"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "occurrences": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "compliance_receipt_id",
              "evidence_refs"
            ],
            "properties": {
              "compliance_receipt_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9._:/-]+$"
              },
              "evidence_refs": {
                "type": "array",
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[A-Za-z0-9._:/-]+$"
                }
              }
            }
          }
        },
        "systemic_threshold": {
          "const": 2
        },
        "recurring_process_owner": {
          "const": "P13"
        },
        "regression_design_owner": {
          "const": "P94"
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_payload_copied",
        "violation_messages_copied",
        "secret_material_copied"
      ],
      "properties": {
        "raw_payload_copied": {
          "const": false
        },
        "violation_messages_copied": {
          "const": false
        },
        "secret_material_copied": {
          "const": false
        }
      }
    }
  }
}
