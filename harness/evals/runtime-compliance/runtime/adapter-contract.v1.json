{
  "schema_version": "prompt-runtime-compliance-agent-adapter-contract/v1",
  "config_schema_version": "prompt-runtime-compliance-agent-adapter/v1",
  "capture_schema_version": "prompt-runtime-compliance-capture/v1",
  "execution": {
    "mode": "argv",
    "shell": false,
    "result_transport": "temporary_json_file",
    "stdout_stderr_persistence": "forbidden",
    "allowed_placeholders": [
      "run_dir",
      "scenario",
      "result"
    ],
    "default_timeout_seconds": 900,
    "max_timeout_seconds": 7200,
    "environment": "minimal_os_plus_explicit_allowlist",
    "launch_errors": "invalid_run_receipt"
  },
  "capture": {
    "schema_path": "harness/evals/runtime-compliance/runtime/capture-schema.v1.json",
    "required_privacy": {
      "raw_transcript_persisted": false,
      "secrets_persisted": false,
      "hidden_reasoning_persisted": false
    },
    "forbidden_persisted_keys": [
      "raw_prompt",
      "raw_response",
      "transcript",
      "chain_of_thought",
      "hidden_reasoning",
      "api_key",
      "credential",
      "secret",
      "token"
    ],
    "fake_adapter_runtime_observed": false,
    "real_external_runtime_required_for_observed": true
  },
  "rtc04": {
    "required_action_fields": [
      "action_id",
      "sequence",
      "side_effect_state",
      "target_identity",
      "pre_state_fingerprint",
      "readback_of_action_id",
      "retry_of_action_id"
    ],
    "readback_before_retry": true,
    "unresolved_readback_disposition": "INCONCLUSIVE_OR_BLOCKED",
    "duplicate_effect_disposition": "FAIL"
  },
  "invalid_run_codes": [
    "RUNTIME_UNAVAILABLE",
    "ADAPTER_CONFIG_INVALID",
    "ADAPTER_EXIT_NONZERO",
    "ADAPTER_LAUNCH_ERROR",
    "ADAPTER_RESULT_MISSING",
    "ADAPTER_RESULT_INVALID",
    "CAPTURE_PRIVACY_REJECTED",
    "ADAPTER_TIMEOUT",
    "EVIDENCE_INCOMPLETE"
  ],
  "proof_boundary": "Repository runtime-harness behavior only. Fake adapters never prove target runtime compliance; external-agent observation requires a real adapter plus observed-behavior evidence."
}
