{
  "schema_version": "lua-harness-validators/v1",
  "validators": [
    {
      "id": "lua-harness-completeness",
      "class": "contract",
      "command": "python scripts/validate_lua_harness.py --output Outputs/lua-embedding-readiness.json --summary",
      "blocking": true,
      "output": "Outputs/lua-embedding-readiness.json",
      "proof_ceiling": "Lua harness component, registry, design-boundary, and static readiness proof."
    },
    {
      "id": "lua-harness-contract-tests",
      "class": "test",
      "command": "python -m unittest tests.test_lua_harness_contract -v",
      "blocking": true,
      "output": "process log",
      "proof_ceiling": "Executable mutation and regression proof for the Lua readiness contract."
    },
    {
      "id": "patch-hygiene",
      "class": "lint",
      "command": "git diff --check",
      "blocking": true,
      "output": "process log",
      "proof_ceiling": "Whitespace and conflict-marker proof for the current diff."
    }
  ],
  "profiles": {
    "lua": [
      "lua-harness-completeness",
      "lua-harness-contract-tests",
      "patch-hygiene"
    ]
  }
}
