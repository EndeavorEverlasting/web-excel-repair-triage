{
  "schema_version": "web-excel-harness/v1",
  "repository": "EndeavorEverlasting/web-excel-repair-triage",
  "default_branch": "main",
  "governance": "AGENTS.md",
  "components": {
    "codebase_map": "CODEBASE_MAP.md",
    "workflow_spec": "WORKFLOW.md",
    "artifact_registry": "ARTIFACT_REGISTRY.md",
    "skill_index": "SKILLS.md",
    "capability_index": "CAPABILITIES.md",
    "trigger_index": "TRIGGERS.md",
    "capability_registry": "harness/capabilities.v1.json",
    "trigger_registry": "harness/triggers.v1.json",
    "prompt_language_eval_policy": "harness/evals/prompt-language-audit.v1.json",
    "prompt_language_eval_fixtures": "harness/evals/fixtures/prompt-language-cases.v1.json",
    "prompt_language_eval_runner": "scripts/evaluate_prompt_language.py",
    "prompt_language_eval_tests": "tests/test_prompt_language_audit.py",
    "validator": "scripts/validate_harness.py",
    "contract_tests": "tests/test_harness_contract.py",
    "pre_commit_hook": ".githooks/pre-commit",
    "pre_push_hook": ".githooks/pre-push",
    "operator_report": "harness/reports/CURRENT_STATE.md"
  },
  "domain_contracts": {
    "prompt_kit_interactions": {
      "contract": "harness/contracts/prompt-kit-interactions.v1.json",
      "validator": "scripts/validate_prompt_kit_interactions.py",
      "contract_tests": "tests/test_prompt_kit_interactions_contract.py",
      "workflow": "WORKFLOW.md#b-prompt-registry-or-website-change",
      "harness_gate": "python scripts/validate_prompt_kit_interactions.py --output Outputs/prompt-kit-interaction-audit.json --summary",
      "strict_product_gate": "python scripts/validate_prompt_kit_interactions.py --require-implementation --output Outputs/prompt-kit-interaction-audit.json --summary"
    },
    "prompt_kit_discovery": {
      "contract": "harness/contracts/prompt-kit-discovery.v1.json",
      "validator": "scripts/validate_prompt_kit_discovery.py",
      "contract_tests": "tests/test_prompt_kit_discovery.py",
      "workflow": "WORKFLOW.md#b-prompt-registry-or-website-change",
      "harness_gate": "python scripts/validate_prompt_kit_discovery.py --summary",
      "strict_product_gate": "python -m unittest tests.test_prompt_kit_discovery -v"
    },
    "webexcel_font_compatibility": {
      "policy": "configs/webexcel_fonts_v1.json",
      "default_font": "Aptos",
      "forbidden_fonts": ["Carlito"],
      "codebase_map": "harness/webexcel-fonts/CODEBASE_MAP.md",
      "workflow": "harness/webexcel-fonts/WORKFLOWS.md",
      "artifact_registry": "harness/webexcel-fonts/ARTIFACT_REGISTRY.md",
      "registry": "harness/webexcel-fonts/registry.json",
      "validator": "scripts/validate_webexcel_fonts.py",
      "completeness_validator": "scripts/validate_webexcel_font_harness.py",
      "contract_tests": ["tests/test_webexcel_font_compatibility.py", "tests/test_webexcel_font_harness.py", "tests/test_webexcel_font_review_regressions.py"],
      "skill": ".ai/skills/webexcel-font-compatibility/SKILL.md",
      "operator_report": "reports/harness/webexcel-font-compatibility-state.md",
      "ci_workflow": ".github/workflows/webexcel-font-harness.yml",
      "artifact_gate": "python scripts/validate_webexcel_fonts.py --workbook <path> --require-workbook --output Outputs/webexcel-font-validation.json --summary",
      "proof_ceiling": "Static source and OOXML font declarations; Excel for Web visual rendering remains field proof."
    },
    "workbook_visual_integrity": {
      "policy": "configs/workbook_visual_integrity_v1.json",
      "registry": "harness/workbook-visual-integrity/registry.json",
      "validator": "scripts/validate_workbook_visual_integrity.py",
      "guarded_runtime_validator": "scripts/validate_workbook_visual_integrity_guarded.py",
      "completeness_validator": "scripts/validate_workbook_visual_harness.py",
      "skill": ".ai/skills/workbook-visual-integrity/SKILL.md",
      "ci_workflow": ".github/workflows/workbook-visual-integrity.yml",
      "proof_ceiling": "Static profile, OOXML visual, and guarded runtime proof; Excel for Web acceptance remains separate."
    }
  },
  "skills": [
    ".ai/skills/prompt-language-audit/SKILL.md",
    ".ai/skills/skill-evaluation/SKILL.md",
    ".ai/skills/skill-factoring/SKILL.md",
    ".ai/skills/technician-prompt-kit-acquisition/SKILL.md"
  ],
  "technician_acquisition": {
    "launcher": "Acquire-Latest-PromptKit.cmd",
    "gui": "scripts/Acquire-LatestPromptKit.ps1",
    "repository_url": "https://github.com/EndeavorEverlasting/web-excel-repair-triage.git",
    "required_files": ["web/prompt-kit/index.html", "Run-PromptKitGenerator.cmd", "Build-PromptKitWebsite.cmd", "configs/prompt_kit/generators.v1.json", "scripts/build_prompt_kit_registry.py"],
    "safety": {"clone_when_absent": true, "fast_forward_only": true, "refuse_dirty_worktree": true, "refuse_divergence": true, "force_push": false, "destructive_reset": false, "embedded_credentials": false}
  },
  "validation_order": [
    "python scripts/validate_harness.py",
    "python scripts/validate_webexcel_font_harness.py --output Outputs/webexcel-font-harness.json --summary",
    "python -m unittest tests.test_webexcel_font_compatibility tests.test_webexcel_font_harness tests.test_webexcel_font_review_regressions -v",
    "python scripts/validate_webexcel_fonts.py --scan-source --output Outputs/webexcel-font-validation.json --summary",
    "python scripts/validate_workbook_visual_harness.py --output Outputs/workbook-visual-harness.json --summary",
    "python -m unittest tests.test_workbook_visual_integrity tests.test_workbook_visual_integrity_guarded tests.test_workbook_visual_harness -v",
    "python scripts/validate_workbook_visual_integrity.py --validate-profiles --output Outputs/workbook-visual-profile-audit.json --summary",
    "python scripts/validate_workbook_visual_integrity_guarded.py --validate-profiles --output Outputs/workbook-visual-profile-guard-audit.json --summary",
    "python -m unittest tests.test_harness_contract -v",
    "python -m unittest tests.test_prompt_kit_interactions_contract -v",
    "python scripts/validate_prompt_kit_interactions.py --output Outputs/prompt-kit-interaction-audit.json --summary",
    "python scripts/validate_prompt_kit_discovery.py --summary",
    "python -m unittest tests.test_prompt_kit_discovery -v",
    "python -m unittest tests.test_prompt_language_audit -v",
    "python scripts/evaluate_prompt_language.py --output Outputs/prompt-language-audit.json --summary",
    "python -m unittest tests.test_skill_prompt_registry -v",
    "python tests/test_prompt_kit_header_contract.py",
    "python scripts/build_prompt_kit_registry.py --output web/prompt-kit/index.html --check",
    "python -m triage.gitignore_hygiene",
    "git diff --check"
  ]
}
