      "target_runtime_observed_to_production_observed",
      "observed_runtime_to_operator_acceptance"
    ],
    "target_runtime_pass_requires_actual_interaction": true,
    "installed_or_deployed_is_not_observed": true,
    "operator_acceptance_is_separate": true,
    "inaccessible_runtime_disposition": "UNKNOWN_OR_UNPROVEN_WITH_EXACT_GATE"
  }
