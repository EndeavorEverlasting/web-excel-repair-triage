{
  "schema_version": "prompt-topology-config/v1",
  "config_id": "prompt-topology-classifier-v1",
  "classifier_version": "1.0.0-phase-a",
  "description": "Executable deterministic Phase A topology config. Semantic graph truth is renderer-neutral; 3D projection and live behavior are later phases.",
  "pipeline": {
    "canonical_record": {
      "parser": "scripts/build_prompt_kit_registry.py:load_prompt_kit_registry",
      "classification_policy": "registry/prompts/prompt-classification.v1.json",
      "tutorial_coverage": "scripts/prompt_kit_tutorial_coverage.py:audit"
    },
    "embeddings": {
      "provider_adapter": "scripts/prompt-topology/pipeline.py:build_embeddings",
      "default_provider": "local-hashing-vectorizer/v1",
      "dimensions": 384,
      "replaceable": true,
      "network_required": false
    },
    "similarity": {
      "metric": "cosine",
      "weights": {
        "semantic": 0.7,
        "role": 0.2,
        "metadata": 0.1
      },
      "persisted_score_unit": "integer_micros"
    },
    "neighbors": {
      "top_k": 15
    },
    "clustering": {
      "algorithm": "hdbscan",
      "implementation": "sklearn.cluster.HDBSCAN",
      "input": "semantic+role composite reduced by deterministic PCA; never renderer coordinates",
      "reduction": {
        "method": "pca",
        "intermediate_pca_dimensions": 32,
        "solver": "full"
      },
      "hdbscan_params": {
        "min_cluster_size": 3,
        "min_samples": 2,
        "metric": "euclidean",
        "cluster_selection_method": "eom",
        "allow_single_cluster": false
      },
      "cluster_identity": {
        "persistent_id_pattern": "^C-[0-9A-F]{6}$",
        "initial_assignment": "deterministic id seeded from first accepted membership fingerprint",
        "membership_fingerprint": "sha256(sorted member prompt ids joined by comma)",
        "reconciliation": "inherit the highest-overlap unused prior cluster at Jaccard >= 0.50",
        "lineage": ["NEW", "UNCHANGED", "EXPANDED", "CONTRACTED", "REVISED"],
        "membership_hash_is_not_permanent_identity": true
      }
    },
    "classification": {
      "family_assignment": {
        "method": "member declared-family majority",
        "threshold": 0.6
      },
      "duplicate_detection": {
        "thresholds": {
          "POSSIBLE_DUPLICATE": 0.94,
          "STRENGTHEN_EXISTING_CANDIDATE": 0.88,
          "RELATED": 0.78
        },
        "advisory_only": true
      }
    },
    "edges": {
      "single_edge_per_prompt_pair": true,
      "phase_a_channels": [
        "SEMANTIC_NEIGHBOR",
        "WORKFLOW_NEXT",
        "CLASS_FAMILY",
        "SHARED_SCOPE",
        "SHARED_EVIDENCE",
        "TUTORIAL_ROUTE"
      ],
      "reserved_live_behavior_channels": [
        "CO_USAGE",
        "TRANSITION",
        "SUBSTITUTION",
        "COMPLEMENT"
      ]
    },
    "opportunities": {
      "advisory_only": true,
      "components": [
        "semantic_gap",
        "ambiguity",
        "underdevelopment",
        "redundancy_penalty",
        "workflow_gap"
      ],
      "formula": "round(0.25*semantic_gap + 0.25*ambiguity + 0.20*underdevelopment + 0.15*redundancy_penalty + 0.15*workflow_gap)",
      "states": ["HEALTHY", "UNDERDEVELOPED", "AMBIGUOUS", "FRAGMENTED", "REDUNDANT", "EMERGING"],
      "actions": ["NONE", "INVESTIGATE_CONTRIBUTION", "STRENGTHEN_EXISTING", "CONNECT_WORKFLOW", "IMPROVE_TUTORIAL", "REVIEW_CLASSIFICATION", "CONSOLIDATE"]
    }
  },
  "artifact": {
    "canonical_path": "artifacts/prompt-topology/topology.v1.json",
    "schema_version": "prompt-topology-artifact/v1",
    "contains": ["nodes", "edges", "clusters", "outlier_prompt_ids", "opportunities", "provenance", "content_hash_sha256"],
    "generated_state_disposable": true,
    "tracked": false
  },
  "determinism": {
    "canonical_json": "UTF-8, LF, sorted keys, two-space indent for persisted artifact",
    "same_input_same_bytes": true,
    "shuffled_source_same_bytes": true,
    "filesystem_order_must_not_matter": true,
    "persist_floats_as_integer_scores_where_semantic": true
  },
  "phase_boundary": {
    "phase_a_owns": ["semantic graph", "clusters", "persistent cluster reconciliation", "opportunity intelligence", "canonical renderer-neutral artifact"],
    "forbidden_in_phase_a": ["3D coordinates", "projection epochs", "cluster envelopes", "WebGL viewer", "live telemetry", "session tracking", "user analytics", "vector database", "prompt renumbering"]
  }
}
