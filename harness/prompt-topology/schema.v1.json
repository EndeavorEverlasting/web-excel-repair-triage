{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prompt-topology/v1",
  "title": "AFKAF Prompt Topology Phase A Canonical Artifact",
  "description": "Renderer-neutral derived semantic topology. Prompt registry remains identity truth; cluster identity persists independently from exact membership fingerprint.",
  "schema_version": "prompt-topology/v1",
  "artifact_schema_version": "prompt-topology-artifact/v1",
  "$defs": {
    "prompt_id": {
      "type": "string",
      "pattern": "^P[0-9]+$"
    },
    "sha256_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "edge_channel": {
      "type": "object",
      "required": ["type", "evidence"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "SEMANTIC_NEIGHBOR",
            "WORKFLOW_NEXT",
            "CLASS_FAMILY",
            "SHARED_SCOPE",
            "SHARED_EVIDENCE",
            "TUTORIAL_ROUTE"
          ]
        },
        "evidence": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["prompt_id", "seq", "title", "prompt_type", "prompt_class", "sprint_path_role", "family_declared_id", "family_declared", "category", "keywords", "record_sha256"],
      "properties": {
        "prompt_id": {"$ref": "#/$defs/prompt_id"},
        "seq": {"type": "string", "pattern": "^[0-9]+$"},
        "title": {"type": "string", "minLength": 1},
        "prompt_type": {"type": "string", "minLength": 1},
        "prompt_class": {"type": "string"},
        "sprint_path_role": {"type": "string"},
        "family_declared_id": {"type": "string"},
        "family_declared": {"type": "string"},
        "category": {"type": "string"},
        "keywords": {"type": "array", "items": {"type": "string"}},
        "record_sha256": {"$ref": "#/$defs/sha256_hex"}
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["source", "target", "channels", "strength_micros"],
      "properties": {
        "source": {"$ref": "#/$defs/prompt_id"},
        "target": {"$ref": "#/$defs/prompt_id"},
        "channels": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/edge_channel"}},
        "strength_micros": {"type": "integer", "minimum": 0, "maximum": 1000000}
      },
      "additionalProperties": false
    },
    "cluster": {
      "type": "object",
      "required": ["cluster_id", "member_prompt_ids", "member_count", "membership_fingerprint_sha256", "lineage", "previous_overlap_micros", "representative_prompt_id", "family_candidate_id", "family_confidence_micros", "family_alignment_distribution", "centrality_micros", "membership_probability_micros"],
      "properties": {
        "cluster_id": {
          "type": "string",
          "pattern": "^C-[0-9A-F]{6}$",
          "description": "Persistent cluster identity. It is not recomputed solely from membership after acceptance."
        },
        "member_prompt_ids": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/prompt_id"}},
        "member_count": {"type": "integer", "minimum": 2},
        "membership_fingerprint_sha256": {"$ref": "#/$defs/sha256_hex"},
        "lineage": {"type": "string", "enum": ["NEW", "UNCHANGED", "EXPANDED", "CONTRACTED", "REVISED"]},
        "previous_overlap_micros": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "representative_prompt_id": {"$ref": "#/$defs/prompt_id"},
        "family_candidate_id": {"type": ["string", "null"]},
        "family_confidence_micros": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "family_alignment_distribution": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "centrality_micros": {"type": "object", "additionalProperties": {"type": "integer", "minimum": -1000000, "maximum": 1000000}},
        "membership_probability_micros": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 1000000}}
      },
      "additionalProperties": false
    },
    "opportunity": {
      "type": "object",
      "required": ["sector_id", "cluster_id", "prompt_ids", "state", "recommended_action", "score", "components", "evidence_refs"],
      "properties": {
        "sector_id": {"type": "string"},
        "cluster_id": {"type": ["string", "null"]},
        "prompt_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/prompt_id"}},
        "state": {"type": "string", "enum": ["HEALTHY", "UNDERDEVELOPED", "AMBIGUOUS", "FRAGMENTED", "REDUNDANT", "EMERGING"]},
        "recommended_action": {"type": "string", "enum": ["NONE", "INVESTIGATE_CONTRIBUTION", "STRENGTHEN_EXISTING", "CONNECT_WORKFLOW", "IMPROVE_TUTORIAL", "REVIEW_CLASSIFICATION", "CONSOLIDATE"]},
        "score": {"type": "integer", "minimum": 0, "maximum": 100},
        "components": {
          "type": "object",
          "required": ["semantic_gap", "ambiguity", "underdevelopment", "redundancy_penalty", "workflow_gap"],
          "properties": {
            "semantic_gap": {"type": "integer", "minimum": 0, "maximum": 100},
            "ambiguity": {"type": "integer", "minimum": 0, "maximum": 100},
            "underdevelopment": {"type": "integer", "minimum": 0, "maximum": 100},
            "redundancy_penalty": {"type": "integer", "minimum": 0, "maximum": 100},
            "workflow_gap": {"type": "integer", "minimum": 0, "maximum": 100}
          },
          "additionalProperties": false
        },
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "artifact": {
    "path": "artifacts/prompt-topology/topology.v1.json",
    "schema": {
      "type": "object",
      "required": ["schema_version", "nodes", "edges", "clusters", "outlier_prompt_ids", "opportunities", "provenance", "content_hash_sha256"],
      "properties": {
        "schema_version": {"type": "string", "const": "prompt-topology-artifact/v1"},
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
        "clusters": {"type": "array", "items": {"$ref": "#/$defs/cluster"}},
        "outlier_prompt_ids": {"type": "array", "items": {"$ref": "#/$defs/prompt_id"}},
        "opportunities": {"type": "array", "items": {"$ref": "#/$defs/opportunity"}},
        "provenance": {"type": "object"},
        "content_hash_sha256": {"$ref": "#/$defs/sha256_hex"}
      },
      "additionalProperties": false
    }
  },
  "determinism_contract": {
    "rules": [
      "Every canonical prompt appears exactly once as a node and Prompt ID is node identity.",
      "One unordered prompt pair produces at most one canonical edge carrying an ordered channel list.",
      "Reserved live-behavior channels are absent from Phase A artifacts.",
      "Persistent cluster IDs reconcile against a prior accepted topology; exact membership is recorded separately as membership_fingerprint_sha256.",
      "Generated topology bytes are identical for identical canonical inputs, including shuffled source enumeration.",
      "Renderer or projection coordinates cannot affect nodes, edges, clusters, opportunities, or content hash."
    ]
  },
  "authority_boundary": {
    "source_truth": ["docs/prompts.json", "registry/prompts/*.json", "registry/prompts/prompt-classification.v1.json", "harness/prompt-topology/config.v1.json"],
    "derived_truth": ["artifacts/prompt-topology/topology.v1.json"],
    "forbidden_mutations": ["prompt IDs", "prompt seq", "canonical prompt registry", "3D projection state", "live user telemetry"]
  }
}
