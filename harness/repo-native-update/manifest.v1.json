  "entry_command": "python scripts/validate_repo_native_update_harness.py --summary",
  "generate_command": "python scripts/run_repo_native_update.py generate --surface canary-constants",
  "check_command": "python scripts/run_repo_native_update.py generate --surface canary-constants --check",
  "proof_ceiling": "Deterministic owned-surface generation, fail-closed path ownership, idempotent repeat runs, and receipt provenance for the canary-constants surface. Local CLI only; no GitHub Actions required."
}
