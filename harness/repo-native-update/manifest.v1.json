{
  "schema_version": "web-excel-repo-native-update-harness/v1",
  "name": "Repository-native code update harness",
  "components": {
    "sprint_plan": "harness/repo-native-update/SPRINT_PLAN.md",
    "codebase_map": "harness/repo-native-update/CODEBASE_MAP.md",
    "workflow": "harness/repo-native-update/WORKFLOW.md",
    "contract": "harness/repo-native-update/contracts/repo-native-update.v1.json",
    "artifact_registry": "harness/repo-native-update/artifacts.v1.json",
    "canary_input": "harness/repo-native-update/inputs/canary-constants.v1.json",
    "generated_readme": "harness/repo-native-update/generated/README.md",
    "generator": "scripts/run_repo_native_update.py",
    "library": "scripts/repo_native_update_lib.py",
    "validator": "scripts/validate_repo_native_update_harness.py",
    "tests": "tests/test_repo_native_update.py",
    "launcher": "Run-RepoNativeUpdate.cmd",
    "operator_report": "harness/repo-native-update/reports/CURRENT_STATE.md"
  },
  "required_component_keys": [
    "contract",
    "generator",
    "validator",
    "tests",
    "canary_input",
    "launcher"
