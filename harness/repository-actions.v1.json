{
  "schema_version": "repository-actions/v1",
  "registry_id": "web-excel-repair-triage-local-actions",
  "purpose": "Provide reviewed, allow-listed repository-local build and proof actions that remain executable when hosted-provider quota or connector capacity is unavailable.",
  "runner": "scripts/run_repository_action.py",
  "provider_adapter": ".github/workflows/repository-local-action.yml",
  "receipt_schema_version": "repository-action-receipt/v1",
  "principles": [
    "Local action definitions are tracked repository authority; callers select an action id and may not inject arbitrary shell.",
    "The local runner is canonical; hosted workflows are optional thin adapters that delegate to the same action id.",
    "A local PASS proves only the declared local proof ceiling and never silently proves hosted, deployed, live-runtime, device, or operator acceptance.",
    "When a needed action is missing and the active lane owns the seam, add the smallest reviewed action plus focused regression before relying on hosted CI."
  ],
  "actions": [
    {
      "id": "prompt-kit-build-proof",
      "description": "Rebuild the canonical Prompt Kit and prove quota-resilient prompt/local-action semantics.",
      "mutation_authority": "canonical_generated_prompt_kit_only",
      "provider_safe": true,
      "steps": [
        {
          "id": "build",
          "argv": [
            "{python}",
            "scripts/build_prompt_kit_registry.py",
            "--output",
            "web/prompt-kit/index.html"
          ],
          "timeout_seconds": 180,
          "proof_ceiling": "Deterministic canonical Prompt Kit generation."
        },
        {
          "id": "local-proof-regressions",
          "argv": [
            "{python}",
            "-m",
            "unittest",
            "tests.test_repository_actions",
            "tests.test_repository_local_proof_continuity",
            "tests.test_prompt_compilation",
            "-v"
          ],
          "timeout_seconds": 180,
          "proof_ceiling": "Executable local-action and P07 local-proof semantic regression."
        },
        {
          "id": "actionability-regressions",
          "argv": [
            "{python}",
            "-m",
            "unittest",
            "tests.test_actionable_prompt_registry",
            "tests.test_skill_prompt_registry",
            "-v"
          ],
          "timeout_seconds": 240,
          "proof_ceiling": "Effective Prompt Kit shared-policy and specialist-registry regression."
        },
        {
          "id": "language-audit",
          "argv": [
            "{python}",
            "scripts/evaluate_prompt_language.py",
            "--summary"
          ],
          "timeout_seconds": 180,
          "proof_ceiling": "Static complete prompt-language coverage."
        },
        {
          "id": "parity",
          "argv": [
            "{python}",
            "scripts/build_prompt_kit_registry.py",
            "--output",
            "web/prompt-kit/index.html",
            "--check"
          ],
          "timeout_seconds": 180,
          "proof_ceiling": "Canonical source-to-generated-site parity."
        },
        {
          "id": "diff-hygiene",
          "argv": [
            "git",
            "diff",
            "--check"
          ],
          "timeout_seconds": 60,
          "proof_ceiling": "Whitespace and conflict-marker proof for the working diff."
        }
      ]
    },
    {
      "id": "prompt-kit-proof",
      "description": "Prove Prompt Kit/local-action semantics without regenerating tracked output.",
      "mutation_authority": "none",
      "provider_safe": true,
      "steps": [
        {
          "id": "local-proof-regressions",
          "argv": [
            "{python}",
            "-m",
            "unittest",
            "tests.test_repository_actions",
            "tests.test_repository_local_proof_continuity",
            "tests.test_prompt_compilation",
            "-v"
          ],
          "timeout_seconds": 180,
          "proof_ceiling": "Executable local-action and P07 local-proof semantic regression."
        },
        {
          "id": "actionability-regressions",
          "argv": [
            "{python}",
            "-m",
            "unittest",
            "tests.test_actionable_prompt_registry",
            "tests.test_skill_prompt_registry",
            "-v"
          ],
          "timeout_seconds": 240,
          "proof_ceiling": "Effective Prompt Kit shared-policy and specialist-registry regression."
        },
        {
          "id": "language-audit",
          "argv": [
            "{python}",
            "scripts/evaluate_prompt_language.py",
            "--summary"
          ],
          "timeout_seconds": 180,
          "proof_ceiling": "Static complete prompt-language coverage."
        },
        {
          "id": "parity",
          "argv": [
            "{python}",
            "scripts/build_prompt_kit_registry.py",
            "--output",
            "web/prompt-kit/index.html",
            "--check"
          ],
          "timeout_seconds": 180,
          "proof_ceiling": "Canonical source-to-generated-site parity."
        },
        {
          "id": "diff-hygiene",
          "argv": [
            "git",
            "diff",
            "--check"
          ],
          "timeout_seconds": 60,
          "proof_ceiling": "Whitespace and conflict-marker proof for the working diff."
        }
      ]
    },
    {
      "id": "pre-push-proof",
      "description": "Run the repository-owned pre-push validator profile without requiring hosted CI.",
      "mutation_authority": "ephemeral_outputs_only",
      "provider_safe": true,
      "steps": [
        {
          "id": "validator-profile",
          "argv": [
            "{python}",
            "scripts/run_validator_profile.py",
            "--profile",
            "pre_push",
            "--report",
            "Outputs/repository-actions/pre-push-validator-profile.json"
          ],
          "timeout_seconds": 1200,
          "proof_ceiling": "Repository-defined pre-push validation profile on the observed checkout."
        },
        {
          "id": "diff-hygiene",
          "argv": [
            "git",
            "diff",
            "--check"
          ],
          "timeout_seconds": 60,
          "proof_ceiling": "Whitespace and conflict-marker proof for the working diff."
        }
      ]
    },
    {
      "id": "repo-native-update-check",
      "description": "Prove the existing repository-native generator path without hosted Actions.",
      "mutation_authority": "ephemeral_outputs_only",
      "provider_safe": true,
      "steps": [
        {
          "id": "generator-parity",
          "argv": [
            "{python}",
            "scripts/run_repo_native_update.py",
            "generate",
            "--surface",
            "canary-constants",
            "--check"
          ],
          "timeout_seconds": 120,
          "proof_ceiling": "Declared repo-native generated-surface parity."
        },
        {
          "id": "generator-tests",
          "argv": [
            "{python}",
            "-m",
            "unittest",
            "tests.test_repo_native_update",
            "-v"
          ],
          "timeout_seconds": 180,
          "proof_ceiling": "Executable repo-native update fail-closed and idempotency regression."
        }
      ]
    }
  ]
}
