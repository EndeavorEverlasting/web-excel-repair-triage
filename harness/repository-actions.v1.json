{
  "schema_version": "repository-actions/v1",
  "registry_id": "web-excel-repair-triage-local-actions",
  "purpose": "Provide reviewed, allow-listed repository-local build and proof actions that remain executable when hosted-provider quota or connector capacity is unavailable.",
  "runner": "scripts/run_repository_action.py",
  "provider_adapter": ".github/workflows/repository-local-action.yml",
  "receipt_schema_version": "repository-action-receipt/v1",
  "principles": [
    "Local action definitions are tracked repository authority; callers select an action id and may not inject arbitrary shell.",
    "The local runner is canonical; hosted workflows are optional thin adapters that delegate to the same action id.",
    "A local PASS proves only the declared local proof ceiling and never silently proves hosted, deployed, live-runtime, device, or operator acceptance.",
    "Every committed-candidate proof action includes exact-candidate patch hygiene against the merge base of the declared base ref.",
    "Every action declares the canonical tracked proof inputs whose exact blob revisions are persisted in the receipt."
  ],
  "actions": [
    {
      "id": "prompt-kit-build-proof",
      "description": "Rebuild the canonical Prompt Kit and prove repository-local Prompt Kit semantics.",
      "mutation_authority": "canonical_generated_prompt_kit_only",
      "provider_safe": true,
      "proof_inputs": [
        "registry/prompts/actionable-next-step-policy.v1.json",
        "scripts/build_prompt_kit_registry.py",
        "scripts/validate_prompt_regression_safety.py",
        "scripts/evaluate_prompt_language.py",
        "harness/contracts/prompt-regression-safety.v1.json",
        "harness/evals/prompt-regression/defect-families.v1.json",
        "harness/test-floor.v1.json",
        "tests/test_repository_actions.py",
        "tests/test_repository_local_proof_continuity_prompt.py"
      ],
      "steps": [
        {"id": "build", "argv": ["{python}", "scripts/build_prompt_kit_registry.py", "--output", "web/prompt-kit/index.html"], "timeout_seconds": 180, "proof_ceiling": "Deterministic canonical Prompt Kit generation."},
        {"id": "local-action-regressions", "argv": ["{python}", "-m", "unittest", "tests.test_repository_actions", "tests.test_repository_local_proof_continuity_prompt", "-v"], "timeout_seconds": 180, "proof_ceiling": "Executable repository-local action and continuity regression."},
        {"id": "regression-safety", "argv": ["{python}", "scripts/validate_prompt_regression_safety.py", "--summary"], "timeout_seconds": 180, "proof_ceiling": "Static systemic-defect and local-first-proof contract validation."},
        {"id": "language-audit", "argv": ["{python}", "scripts/evaluate_prompt_language.py", "--summary"], "timeout_seconds": 180, "proof_ceiling": "Static complete prompt-language coverage."},
        {"id": "parity", "argv": ["{python}", "scripts/build_prompt_kit_registry.py", "--output", "web/prompt-kit/index.html", "--check"], "timeout_seconds": 180, "proof_ceiling": "Canonical source-to-generated-site parity."},
        {"id": "exact-candidate-patch-hygiene", "argv": ["git", "diff", "--check", "{base_sha}...{head_sha}"], "timeout_seconds": 60, "proof_ceiling": "Whitespace and conflict-marker proof for the exact committed candidate."}
      ]
    },
    {
      "id": "prompt-kit-proof",
      "description": "Prove Prompt Kit and repository-local action semantics without regenerating tracked output.",
      "mutation_authority": "none",
      "provider_safe": true,
      "proof_inputs": [
        "registry/prompts/actionable-next-step-policy.v1.json",
        "scripts/build_prompt_kit_registry.py",
        "scripts/validate_prompt_regression_safety.py",
        "scripts/evaluate_prompt_language.py",
        "harness/contracts/prompt-regression-safety.v1.json",
        "harness/evals/prompt-regression/defect-families.v1.json",
        "harness/test-floor.v1.json",
        "tests/test_repository_actions.py",
        "tests/test_repository_local_proof_continuity_prompt.py"
      ],
      "steps": [
        {"id": "local-action-regressions", "argv": ["{python}", "-m", "unittest", "tests.test_repository_actions", "tests.test_repository_local_proof_continuity_prompt", "-v"], "timeout_seconds": 180, "proof_ceiling": "Executable repository-local action and continuity regression."},
        {"id": "regression-safety", "argv": ["{python}", "scripts/validate_prompt_regression_safety.py", "--summary"], "timeout_seconds": 180, "proof_ceiling": "Static systemic-defect and local-first-proof contract validation."},
        {"id": "language-audit", "argv": ["{python}", "scripts/evaluate_prompt_language.py", "--summary"], "timeout_seconds": 180, "proof_ceiling": "Static complete prompt-language coverage."},
        {"id": "parity", "argv": ["{python}", "scripts/build_prompt_kit_registry.py", "--output", "web/prompt-kit/index.html", "--check"], "timeout_seconds": 180, "proof_ceiling": "Canonical source-to-generated-site parity."},
        {"id": "exact-candidate-patch-hygiene", "argv": ["git", "diff", "--check", "{base_sha}...{head_sha}"], "timeout_seconds": 60, "proof_ceiling": "Whitespace and conflict-marker proof for the exact committed candidate."}
      ]
    },
    {
      "id": "required-checks-proof",
      "description": "Run the repository-owned local equivalents of required provider checks and exact-candidate patch hygiene.",
      "mutation_authority": "ephemeral_outputs_only",
      "provider_safe": true,
      "proof_inputs": [
        "scripts/run_local_required_checks.py",
        "scripts/run_validator_profile.py",
        "harness/validators.v1.json",
        "harness/promotion/required-checks.v1.json"
      ],
      "steps": [
        {"id": "required-checks", "argv": ["{python}", "scripts/run_local_required_checks.py", "--report", "Outputs/repository-actions/local-required-checks.json", "--summary"], "timeout_seconds": 1200, "proof_ceiling": "Repository-owned local equivalents of required governance and operational-harness checks."},
        {"id": "exact-candidate-patch-hygiene", "argv": ["git", "diff", "--check", "{base_sha}...{head_sha}"], "timeout_seconds": 60, "proof_ceiling": "Whitespace and conflict-marker proof for the exact committed candidate."}
      ]
    },
    {
      "id": "pre-push-proof",
      "description": "Run the repository-owned pre-push validator profile without requiring hosted CI.",
      "mutation_authority": "ephemeral_outputs_only",
      "provider_safe": true,
      "proof_inputs": [
        "scripts/run_validator_profile.py",
        "harness/validators.v1.json"
      ],
      "steps": [
        {"id": "validator-profile", "argv": ["{python}", "scripts/run_validator_profile.py", "--profile", "pre_push", "--report", "Outputs/repository-actions/pre-push-validator-profile.json"], "timeout_seconds": 1200, "proof_ceiling": "Repository-defined pre-push validation profile on the observed checkout."},
        {"id": "exact-candidate-patch-hygiene", "argv": ["git", "diff", "--check", "{base_sha}...{head_sha}"], "timeout_seconds": 60, "proof_ceiling": "Whitespace and conflict-marker proof for the exact committed candidate."}
      ]
    },
    {
      "id": "repo-native-update-check",
      "description": "Prove the existing repository-native generator path without hosted Actions.",
      "mutation_authority": "ephemeral_outputs_only",
      "provider_safe": true,
      "proof_inputs": [
        "scripts/run_repo_native_update.py",
        "harness/repo-native-update/manifest.v1.json",
        "harness/repo-native-update/artifacts.v1.json",
        "harness/repo-native-update/inputs/canary-constants.v1.json",
        "tests/test_repo_native_update.py"
      ],
      "steps": [
        {"id": "generator-parity", "argv": ["{python}", "scripts/run_repo_native_update.py", "generate", "--surface", "canary-constants", "--check"], "timeout_seconds": 120, "proof_ceiling": "Declared repo-native generated-surface parity."},
        {"id": "generator-tests", "argv": ["{python}", "-m", "unittest", "tests.test_repo_native_update", "-v"], "timeout_seconds": 180, "proof_ceiling": "Executable repo-native update fail-closed and idempotency regression."},
        {"id": "exact-candidate-patch-hygiene", "argv": ["git", "diff", "--check", "{base_sha}...{head_sha}"], "timeout_seconds": 60, "proof_ceiling": "Whitespace and conflict-marker proof for the exact committed candidate."}
      ]
    }
  ]
}
