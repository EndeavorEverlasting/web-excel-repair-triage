{
  "schema_version": "web-excel-validators/v1",
  "validators": [
    {
      "id": "harness-completeness",
      "class": "contract",
      "command": "python scripts/validate_harness.py --report Outputs/harness-completeness-report.json",
      "blocking": true,
      "output": "Outputs/harness-completeness-report.json",
      "proof_ceiling": "Static completeness, routing, registry, hook, acquisition, and connected-contract proof."
    },
    {
      "id": "harness-contract-tests",
      "class": "test",
      "command": "python -m unittest tests.test_harness_contract -v",
      "blocking": true,
      "output": "process log",
      "proof_ceiling": "Executable regression proof for registered harness contracts."
    },
    {
      "id": "prompt-kit-interaction-contract-tests",
      "class": "test",
      "command": "python -m unittest tests.test_prompt_kit_interactions_contract -v",
      "blocking": true,
      "output": "process log",
      "proof_ceiling": "Interaction contract and static fixture proof."
    },
    {
      "id": "prompt-kit-interaction-audit",
      "class": "contract",
      "command": "python scripts/validate_prompt_kit_interactions.py --output Outputs/prompt-kit-interaction-audit.json --summary",
      "blocking": true,
      "output": "Outputs/prompt-kit-interaction-audit.json",
      "proof_ceiling": "Static contract audit; non-strict mode may retain a product implementation gap."
    },
    {
      "id": "prompt-kit-discovery-audit",
      "class": "contract",
      "command": "python scripts/validate_prompt_kit_discovery.py --summary",
      "blocking": true,
      "output": "process log",
      "proof_ceiling": "Static prompt discovery and registration proof."
    },
    {
      "id": "prompt-kit-discovery-tests",
      "class": "test",
      "command": "python -m unittest tests.test_prompt_kit_discovery -v",
      "blocking": true,
      "output": "process log",
      "proof_ceiling": "Executable prompt discovery regression proof."
    },
    {
      "id": "prompt-language-contract-tests",
      "class": "test",
      "command": "python -m unittest tests.test_prompt_language_audit -v",
      "blocking": true,
      "output": "process log",
      "proof_ceiling": "Prompt-language policy and mutation-fixture proof."
    },
    {
      "id": "prompt-language-audit",
      "class": "contract",
      "command": "python scripts/evaluate_prompt_language.py --output Outputs/prompt-language-audit.json --summary",
      "blocking": true,
      "output": "Outputs/prompt-language-audit.json",
      "proof_ceiling": "Exhaustive static prompt-language coverage and disposition proof."
    },
    {
      "id": "skill-prompt-registry-tests",
      "class": "test",
      "command": "python -m unittest tests.test_skill_prompt_registry -v",
      "blocking": true,
      "output": "process log",
      "proof_ceiling": "Skill prompt registry identity and integration proof."
    },
    {
      "id": "prompt-kit-responsive-layout-audit",
      "class": "contract",
      "command": "python scripts/validate_prompt_kit_layout_harness.py --summary",
      "blocking": true,
      "output": "process log",
      "proof_ceiling": "Static responsive-layout harness and contract completeness proof; no browser geometry proof."
    },
    {
      "id": "prompt-kit-responsive-layout-tests",
      "class": "test",
      "command": "python -m unittest tests.test_prompt_kit_layout_harness -v",
      "blocking": true,
      "output": "process log",
      "proof_ceiling": "Executable responsive-layout harness regression proof; strict browser geometry remains separate."
    },
    {
      "id": "prompt-kit-header-contract",
      "class": "test",
      "command": "python tests/test_prompt_kit_header_contract.py",
      "blocking": true,
      "output": "process log",
      "proof_ceiling": "Checked-in Prompt Kit header contract proof."
    },
    {
      "id": "prompt-kit-parity",
      "class": "build",
      "command": "python scripts/build_prompt_kit_registry.py --output web/prompt-kit/index.html --check",
      "blocking": true,
      "output": "web/prompt-kit/index.html",
      "proof_ceiling": "Deterministic source-to-generated-site parity."
    },
    {
      "id": "staged-artifact-hygiene",
      "class": "lint",
      "command": "python scripts/validate_staged_artifacts.py",
      "blocking": true,
      "output": "process log",
      "proof_ceiling": "Path-only staged-index proof for generated/runtime, binary, secret-like, and machine-local artifact policy."
    },
    {
      "id": "artifact-hygiene",
      "class": "lint",
      "command": "python -m triage.gitignore_hygiene",
      "blocking": true,
      "output": "process log",
      "proof_ceiling": "Tracked and ignored artifact-path policy proof."
    },
    {
      "id": "patch-hygiene",
      "class": "lint",
      "command": "git diff --check",
      "blocking": true,
      "output": "process log",
      "proof_ceiling": "Whitespace and conflict-marker proof for the current diff."
    },
    {
      "id": "patch-hygiene-staged",
      "class": "lint",
      "command": "git diff --cached --check",
      "blocking": true,
      "output": "process log",
      "proof_ceiling": "Whitespace and conflict-marker proof for the staged index."
    },
    {
      "id": "prompt-kit-browser-proof-cleanup-completeness",
      "class": "contract",
      "command": "python scripts/validate_prompt_kit_browser_proof_cleanup.py --summary",
      "blocking": true,
      "output": "process log",
      "proof_ceiling": "Static focused cleanup-harness completeness and safety-marker proof."
    },
    {
      "id": "prompt-kit-browser-proof-cleanup-tests",
      "class": "test",
      "command": "python -m unittest tests.test_prompt_kit_browser_proof_cleanup_harness -v",
      "blocking": true,
      "output": "process log",
      "proof_ceiling": "Executable focused cleanup contract regression proof."
    },
    {
      "id": "prompt-kit-browser-proof-cleanup-powershell-smoke",
      "class": "test",
      "command": "pwsh -NoLogo -NoProfile -File scripts/Clear-PromptKitBrowserProofScratch.ps1",
      "blocking": true,
      "output": "Outputs/prompt-kit-browser-proof-cleanup-report.json",
      "proof_ceiling": "PowerShell preview execution on the current host; not P-Top cleanup proof."
    },
    {
      "id": "app-harness-validation",
      "class": "contract",
      "command": "python scripts/validate_app_harness.py --output Outputs/app-harness-validation.json",
      "blocking": true,
      "output": "Outputs/app-harness-validation.json",
      "proof_ceiling": "Exact-head offline/synthetic harness readiness with explicit requirement classes and honest optional skips; no application/runtime proof."
    },
    {
      "id": "prompt-kit-feedback-afk-routing-audit",
      "class": "contract",
      "command": "python scripts/validate_prompt_kit_feedback_afk_routing.py --summary",
      "blocking": true,
      "output": "process log",
      "proof_ceiling": "Static feedback-AFK ownership, privacy, scheduler, workflow, and promotion-boundary proof."
    },
    {
      "id": "prompt-kit-feedback-afk-routing-tests",
      "class": "test",
      "command": "python -m unittest tests.test_prompt_kit_feedback_afk_routing -v",
      "blocking": true,
      "output": "process log",
      "proof_ceiling": "Executable one-shot classification, dedupe, work-request, and routing-boundary regression proof."
    },
    {
      "id": "operant-product-identity-audit",
      "class": "contract",
      "command": "python scripts/validate_operant_product_identity.py --summary",
      "blocking": true,
      "output": "process log",
      "proof_ceiling": "Static product identity, transition authority, compatibility-path, governance, and generated-brand proof."
    },
    {
      "id": "operant-product-identity-tests",
      "class": "test",
      "command": "python -m unittest tests.test_operant_product_identity -v",
      "blocking": true,
      "output": "process log",
      "proof_ceiling": "Executable regression proof for Operant identity, transition authority, and generated visible-brand invariants."
    }
  ],
  "profiles": {
    "harness": [
      "harness-completeness",
      "harness-contract-tests",
      "operant-product-identity-audit",
      "operant-product-identity-tests",
      "prompt-kit-interaction-contract-tests",
      "prompt-kit-interaction-audit",
      "prompt-kit-discovery-audit",
      "prompt-kit-discovery-tests",
      "prompt-language-contract-tests",
      "prompt-language-audit",
      "skill-prompt-registry-tests",
      "prompt-kit-feedback-afk-routing-audit",
      "prompt-kit-feedback-afk-routing-tests",
      "prompt-kit-responsive-layout-audit",
      "prompt-kit-responsive-layout-tests",
      "prompt-kit-header-contract",
      "prompt-kit-parity",
      "artifact-hygiene",
      "app-harness-validation",
      "patch-hygiene"
    ],
    "artifact-engine": [
      "artifact-hygiene",
      "patch-hygiene"
    ],
    "target-repository": [
      "harness-completeness",
      "harness-contract-tests",
      "patch-hygiene"
    ],
    "pre_commit": [
      "staged-artifact-hygiene",
      "harness-completeness",
      "harness-contract-tests",
      "patch-hygiene-staged"
    ],
    "pre_push": [
      "harness-completeness",
      "harness-contract-tests",
      "operant-product-identity-audit",
      "operant-product-identity-tests",
      "prompt-kit-interaction-contract-tests",
      "prompt-kit-interaction-audit",
      "prompt-kit-discovery-audit",
      "prompt-kit-discovery-tests",
      "prompt-language-contract-tests",
      "prompt-language-audit",
      "skill-prompt-registry-tests",
      "prompt-kit-feedback-afk-routing-audit",
      "prompt-kit-feedback-afk-routing-tests",
      "prompt-kit-responsive-layout-audit",
      "prompt-kit-responsive-layout-tests",
      "prompt-kit-header-contract",
      "prompt-kit-parity",
      "artifact-hygiene",
      "app-harness-validation",
      "patch-hygiene"
    ]
  },
  "hooks": {
    "pre_commit": {
      "path": ".githooks/pre-commit",
      "profile": "pre_commit",
      "index_mode": "staged-tree"
    },
    "pre_push": {
      "path": ".githooks/pre-push",
      "profile": "pre_push",
      "index_mode": "working-tree"
    }
  }
}
